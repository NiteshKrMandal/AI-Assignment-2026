ictions.append(\n                _as_bool_prediction(prediction)\n            )\n\n        except Exception as exc:\n\n            errors.append({\n\n                \"row_index\": int(index),\n\n                \"id\": row[id_col],\n\n                \"error\": (\n                    f\"{type(exc).__name__}: {exc}\"\n                )\n\n            })\n\n            predictions.append(None)\n\n    elapsed = (\n        time.perf_counter() - start\n    )\n\n    # Do not write a partial submission.\n    if errors:\n\n        error_path = Path(output_path).with_name(\n            f\"{source_name}_submission_errors.csv\"\n        )\n\n        pd.DataFrame(errors).to_csv(\n            error_path,\n            index=False\n        )\n\n        raise RuntimeError(\n            f\"{len(errors)} rows could not be predicted. \"\n            f\"No submission was written. Inspect: {error_path}\"\n        )\n\n    # Construct submission.\n    submission = pd.DataFrame({\n\n        \"id\": test_df[id_col].values,\n\n        \"predicted_label\": [\n            \"True\" if prediction else \"False\"\n            for prediction in predictions\n        ]\n\n    })\n\n    # Final validation.\n    if (\n        len(submission) != len(test_df)\n        or submission[\"id\"].duplicated().any()\n        or submission.isna().any().any()\n    ):\n\n        raise AssertionError(\n            \"Submission validation failed.\"\n        )\n\n    if not set(\n        submission[\"predicted_label\"].unique()\n    ).issubset({\"True\", \"False\"}):\n\n        raise AssertionError(\n            \"Submission contains an invalid label.\"\n        )\n\n    # Save only after all validation passes.\n    output_path = Path(output_path)\n\n    output_path.parent.mkdir(\n        parents=True,\n        exist_ok=True\n    )\n\n    submission.to_csv(\n        output_path,\n        index=False\n    )\n\n    print(\n        f\"\\n{source_name.upper()} INFERENCE SUMMARY\"\n    )\n\n    print(\n        \"Rows:\",