==================\n# SECTION 8 — COUNTERBENCH CAUSAL GRAPH REPRESENTATION\n# ============================================================\n\nfrom dataclasses import dataclass, field\nfrom collections import defaultdict, Counter\nimport re\nimport json\n\n# ------------------------------------------------------------\n# 1. Causal edge representation\n# ------------------------------------------------------------\n\n@dataclass(frozen=True)\nclass CausalEdge:\n    \"\"\"\n    A causal relationship.\n\n    parents:\n        One or more causal parent variables.\n\n    child:\n        The affected variable.\n\n    A single parent represents:\n        X -> Y\n\n    Two parents represent:\n        X OR Y -> Z\n    \"\"\"\n    parents: tuple\n    child: str\n\n    def __post_init__(self):\n        object.__setattr__(\n            self,\n            \"parents\",\n            tuple(normalize_text(x) for x in self.parents)\n        )\n        object.__setattr__(\n            self,\n            \"child\",\n            normalize_text(self.child)\n        )\n\n    def __str__(self):\n        return f\"{' OR '.join(self.parents)} -> {self.child}\"\n\n\n# ------------------------------------------------------------\n# 2. Causal graph\n# ------------------------------------------------------------\n\n@dataclass\nclass CausalGraph:\n    edges: list = field(default_factory=list)\n\n    def add_edge(self, edge):\n        if not isinstance(edge, CausalEdge):\n            raise TypeError(\"Expected a CausalEdge.\")\n        self.edges.append(edge)\n\n    @property\n    def variables(self):\n        result = set()\n\n        for edge in self.edges:\n            result.add(edge.child)\n            result.update(edge.parents)\n\n        return result\n\n    def parents_of(self, variable):\n        variable = normalize_text(variable)\n\n        return [\n            edge.parents\n            for edge in self.edges\n            if edge.child == variable\n        ]\n\n    def children_of(self, variable):\n        variable = normalize_text(variable)\n\n        return [\n            edge.child\n            for edge in self.edges\n            if variable in edge.parents\n        ]\n\n    def summary(self):\n        return {\n            \"variables\": sorted(self.variables),\n            \"number_of_variables\": len(self.variables),\n            \"number_of_edges\": len(self.edges),\n            \"edges\": [str(edge) for edge in self.edges]\n        }\n\n\n# ------------------------------------------------------------\n# 3. Parse causal statements from CounterBench text\n# ------------------------------------------------------------\n\n# CounterBench uses generated variable names such as:\n# Ziklo, Blaf, Trune, Vork, Lumbo.\n#\n# Supported patterns:\n#   X causes Y\n#   X or Y causes Z\n\nSINGLE_CAUSE_PATTERN = re.compile(\n    r\"\\b([A-Za-z][A-Za-z0-9_-]*)\\s+causes\\s+\"\n    r\"([A-Za-z][A-Za-z0-9_-]*)\\b\",\n    re.IGNORECASE\n)\n\nDISJUNCTIVE_CAUSE_PATTERN = re.compile(\n    r\"\\b([A-Za-z][A-Za-z0-9_-]*)\\s+or\\s+\"\n    r\"([A-Za-z][A-Za-z0-9_-]*)\\s+causes\\s+\"\n    r\"([A-Za-z][A-Za-z0-9_-]*)\\b\",\n    re.IGNORECASE\n)\n\n\ndef parse_causal_graph(given_info):\n    \"\"\"\n    Extract causal edges from CounterBench given_info.\n\n    Returns:\n        graph: CausalGraph\n        diagnostics: parsing information\n\n    Disjunctive relationships are stored as one edge with\n    multiple parents, not as two independent edges.\n    \"\"\"\n\n    text = str(given_info)\n    graph = CausalGraph()\n\n    # First identify disjunctive relationships.\n    disjunctive_matches = list(\n        DISJUNCTIVE_CAUSE_PATTERN.finditer(text)\n    )\n\n    occupied_spans = [\n        match.span()\n        for match in disjunctive_matches\n    ]\n\n    for match in disjunctive_matches:\n        parent_1, parent_2, child = match.groups()\n\n        graph.add_edge(\n            CausalEdge(\n                parents=(parent_1, parent_2),\n                child=child\n            )\n        )\n\n    # Then identify ordinary single-parent relationships.\n    single_matches = list(\n        SINGLE_CAUSE_PATTERN.finditer(text)\n    )\n\n    single_count = 0\n\n    for match in single_matches:\n        # Do not parse a disjunctive relationship again.\n        if any(\n            start <= match.start() and match.end() <= end\n            for start, end in occupied_spans\n        ):\n            continue\n\n        parent, child = match.groups()\n\n        graph.add_edge(\n            CausalEdge(\n                parents=(parent,),\n                child=child\n            )\n        )\n\n        single_count += 1\n\n    diagnostics = {\n        \"single_parent_edges\": single_count,\n        \"disjunctive_edges\": len(disjunctive_matches),\n        \"total_edges\": len(graph.edges),\n        \"variables\": len(graph.variables)\n    }\n\n    return graph, diagnostics\n\n\n# ------------------------------------------------------------\n# 4. Parse one Alpha example\n# ------------------------------------------------------------\n\nalpha_sample = COUNTERBENCH_ALPHA.iloc[0]\n\nalpha_graph, alpha_diagnostics = parse_causal_graph(\n    alpha_sample[\"given_info\"]\n)\n\nprint(\"=\" * 70)\nprint(\"COUNTERBENCH — SAMPLE CAUSAL GRAPH\")\nprint(\"=\" * 70)\n\nprint(\"\\nQuestion:\", alpha_sample[\"question\"])\nprint(\"Given information:\", alpha_sample[\"given_info\"])\nprint(\"Expected answer:\", alpha_sample[\"answer\"])\n\nprint(\"\\nExtracted edges:\")\nfor edge in alpha_graph.edges:\n    print(\" \", edge)\n\nprint(\"\\nGraph summary:\")\nprint(json.dumps(alpha_graph.summary(), indent=2))\n\nprint(\"\\nParsing diagnostics:\")\nprint(alpha_diagnostics)\n\n\n# ------------------------------------------------------------\n# 5. Parse one Backdoor example\n# ------------------------------------------------------------\n\nbackdoor_sample = COUNTERBENCH_BACKDOOR.iloc[0]\n\nbackdoor_graph, backdoor_diagnostics = parse_causal_graph(\n    backdoor_sample[\"given_info\"]\n)\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"COUNTERBENCH — BACKDOOR SAMPLE\")\nprint(\"=\" * 70)\n\nprint(\"\\nQuestion:\", backdoor_sample[\"question\"])\nprint(\"Given information:\", backdoor_sample[\"given_info\"])\n\nprint(\"\\nExtracted edges:\")\nfor edge in backdoor_graph.edges:\n    print(\" \", edge)\n\nprint(\"\\nParsing diagnostics:\")\nprint(backdoor_diagnostics)\n\n\n# ------------------------------------------------------------\n# 6. Measure parsing coverage across both datasets\n# ------------------------------------------------------------\n\nCOUNTERBENCH_PARSE_STATS = {}\n\nfor dataset_name, df in {\n    \"alpha\": COUNTERBENCH_ALPHA,\n    \"backdoor\": COUNTERBENCH_BACKDOOR\n}.items():\n\n    total_examples = len(df)\n    examples_with_edges = 0\n    total_edges = 0\n    total_variables = 0\n    single_edges = 0\n    disjunctive_edges = 0\n    empty_graph_examples = []\n\n    for index, row in df.iterrows():\n\n        graph, diagnostics = parse_causal_graph(\n            row[\"given_info\"]\n        )\n\n        if graph.edges:\n            examples_with_edges += 1\n        else:\n            empty_graph_examples.append(str(row[\"question_id\"]))\n\n        total_edges += diagnostics[\"total_edges\"]\n        total_variables += diagnostics[\"variables\"]\n        single_edges += diagnostics[\"single_parent_edges\"]\n        disjunctive_edges += diagnostics[\"disjunctive_edges\"]\n\n    stats = {\n        \"examples\": total_examples,\n        \"examples_with_edges\": examples_with_edges,\n        \"empty_graph_examples\": len(empty_graph_examples),\n        \"total_edges\": total_edges,\n        \"single_parent_edges\": single_edges,\n        \"disjunctive_edges\": disjunctive_edges,\n        \"total_variable_occurrences\": total_variables,\n        \"graph_extraction_coverage\": (\n            examples_with_edges / total_examples\n            if total_examples else 0.0\n        ),\n        \"empty_graph_question_ids\": empty_graph_examples[:20]\n    }\n\n    COUNTERBENCH_PARSE_STATS[dataset_name] = stats\n\n    print(\"\\n\" + \"-\" * 70)\n    print(dataset_name.upper())\n    print(\"-\" * 70)\n\n    for key, value in stats.items():\n        print(f\"{key}: {value}\")\n\n\n# ------------------------------------------------------------\n# 7. Verify graph representation behaviour\n# ------------------------------------------------------------\n\ntest_graph = CausalGraph()\n\ntest_graph.add_edge(\n    CausalEdge((\"x\",), \"y\")\n)\n\ntest_graph.add_edge(\n    CausalEdge((\"y\", \"z\"), \"w\")\n)\n\nassert \"x\" in test_graph.variables\nassert \"w\" in test_graph.variables\nassert test_graph.parents_of(\"y\") == [(\"x\",)]\nassert test_graph.children_of(\"y\") == [\"w\"]\n\nassert len(alpha_graph.edges) == alpha_diagnostics[\"total_edges\"]\nassert len(backdoor_graph.edges) == backdoor_diagnostics[\"total_edges\"]\n\n\n# ------------------------------------------------------------\n# 8. Save parsing statistics\n# ------------------------------------------------------------\n\ncounterbench_stats_path = (\n    OUTPUT_DIR / \"counterbench_graph_parser_stats.json\"\n)\n\nwith open(\n    counterbench_stats_path,\n    \"w\",\n    encoding=\"utf-8\"\n) as file:\n    json.dump(\n        COUNTERBENCH_PARSE_STATS,\n        file,\n        indent=4\n    )\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"COUNTERBENCH GRAPH REPRESENTATION TESTS\")\nprint(\"=\" * 70)\n\nprint(\"Parent lookup test: PASSED\")\nprint(\"Child lookup test: PASSED\")\nprint(\"Disjunctive edge representation: PASSED\")\nprint(\"Graph extraction consistency: PASSED\")\n\nprint(\"\\nStatistics saved to:\", counterbench_stats_path)\nprint(\"\\nSection 8 completed successfully.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T12:40:35.218214Z","iopub.execute_input":"2026-11-17T12:40:35.218639Z","iopub.status.idle":"2026-11-17T12:40:35.409219Z","shell.execute_reply.started":"2026-11-17T12:40:35.2186Z","shell.execut