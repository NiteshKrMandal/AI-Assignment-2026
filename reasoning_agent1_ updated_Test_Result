nterbench_backdoor_v21\",\n\n                \"id\": [\n                    f\"counterbench_backdoor_{x}\"\n                    for x in cb[\"question_id\"].astype(str)\n                ],\n\n                \"gold_label\": [\n                    \"True\" if x else \"False\"\n                    for x in cb[\"actual\"].astype(bool)\n                ],\n\n                \"predicted_label\": [\n                    \"True\" if x else \"False\"\n                    for x in cb[\"predicted\"].astype(bool)\n                ],\n\n                \"correct\": cb[\"correct\"].astype(bool).tolist(),\n\n                \"split\": \"public_labeled_evaluation\"\n\n            })\n        )\n\n        metric_rows.append({\n\n            \"task\": \"counterbench_backdoor_v21\",\n\n            \"split\": \"public_labeled_evaluation\",\n\n            \"method\": (\n                \"root-world abduction + intervention + prediction\"\n            ),\n\n            \"examples\": int(\n                metrics_v21[\"examples\"]\n            ),\n\n            \"accuracy\": float(\n                metrics_v21[\"accuracy\"]\n            ),\n\n            \"runtime_seconds\": float(\n                metrics_v21.get(\n                    \"runtime_seconds\",\n                    float(\"nan\")\n                )\n            )\n\n        })\n\n    # --------------------------------------------------------\n    # 6.3 FOLIO\n    # --------------------------------------------------------\n\n    if (\n        \"validation_predictions\" in globals()\n        and not validation_predictions.empty\n    ):\n\n        folio = validation_predictions.copy()\n\n        # Overall validation metrics use all 203 examples.\n        overall_accuracy = (\n            folio[\"correct\"].astype(bool).mean()\n        )\n\n        parser_error_mask = (\n            folio[\"solver_status\"]\n            == \"parse_or_translation_error\"\n        )\n\n        parser_failures = int(\n            parser_error_mask.su