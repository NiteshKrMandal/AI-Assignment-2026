===========\n# 2. FOLIO PROVER\n# ============================================================\n\nclass FOLIOProver:\n    \"\"\"First-order entailment checker using Z3.\"\"\"\n\n    DEFAULT_TIMEOUT_MS = 8000\n    DEFAULT_VARS = {\"x\", \"y\", \"z\", \"w\", \"u\", \"v\"}\n\n    def __init__(self, timeout_ms=None, fuzzy_alignment=True):\n        self.timeout_ms = (\n            self.DEFAULT_TIMEOUT_MS\n            if timeout_ms is None\n            else int(timeout_ms)\n        )\n\n        self.fuzzy_alignment = bool(fuzzy_alignment)\n\n        self.last_status = \"not_run\"\n        self.last_reason = \"\"\n        self.last_solver_reason = \"\"\n\n    # --------------------------------------------------------\n    # 2.1 Clean FOL formula\n    # --------------------------------------------------------\n\n    @staticmethod\n    def clean_fol_line(line):\n\n        line = str(line).strip()\n\n        line = re.sub(\n            r\"(?:Never:|Simeng:|\\[).*$\",\n            \"\",\n            line\n        ).strip()\n\n        line = line.replace(\"—>\", \"→\")\n        line = line.replace(\"->\", \"→\")\n        line = line.replace(\"⟷\", \"↔\")\n\n        line = re.sub(\n            r\"\\b([A-Za-z0-9_.-]+)\\s*=\\s*([A-Za-z0-9_.-]+)\\b\",\n            r\"Equal(\\1, \\2)\",\n            line\n        )\n\n        return line\n\n    # --------------------------------------------------------\n    # 2.2 Tokenizer\n    # --------------------------------------------------------\n\n    @classmethod\n    def tokenize(cls, text):\n\n        text = cls.clean_fol_line(text)\n\n        token_spec = re.compile(\n            r\"\\s*(?:(∀|∃)\\s*([A-Za-z_][A-Za-z0-9_]*)\"\n            r\"|(→|↔|⊕|∧|∨|¬|\\(|\\)|,)\"\n            r\"|([A-Za-z0-9_.\\u00C0-\\u024F-]+))\"\n        )\n\n        tokens = []\n        pos = 0\n\n        while pos < len(text):\n\n            match = token_spec.match(text, pos)\n\n            if not match:\n\n                if text[pos:].strip() == \"\":\n                    break\n\n                raise ValueError(\n                    f\"Unrecognized FOL syntax near: \"\n                    f\"{text[pos:pos+30]!r}\"\n                )\n\n            quantifier, qvar, symbol, identifier = match.groups()\n\n            if quantifier:\n\n                tokens.append(\n                    (\"QUANT\", (quantifier, qvar.lower()))\n                )\n\n            elif symbol:\n\n                tokens.append((symbol, symbol))\n\n            else:\n\n                tokens.append((\"ID\", identifier))\n\n            pos = match.end()\n\n        return tokens\n\n    # --------------------------------------------------------\n    # 2.3 Recursive descent parser\n    # --------------------------------------------------------\n\n    @classmethod\n    def parse_formula(cls, text):\n\n        tokens = cls.tokenize(text)\n\n        if not tokens:\n            raise ValueError(\"Empty FOL formula\")\n\n        pos = 0\n\n        def peek():\n\n            return (\n                tokens[pos]\n                if pos < len(tokens)\n                else (None, None)\n            )\n\n        def consume(expected=None):\n\n            nonlocal pos\n\n            token = peek()\n\n            if expected is not None and token[0] != expected:\n\n                raise ValueError(\n                    f\"Expected {expected}, found {token[0]} \"\n                    f\"in {text!r}\"\n                )\n\n            pos += 1\n\n            return token\n\n        def parse_iff():\n\n            node = parse_imp()\n\n            while peek()[0] == \"↔\":\n\n                consume()\n\n                node = FOLNode(\n                    \"IFF\",\n                    children=[node, parse_imp()]\n                )\n\n            return node\n\n        def parse_imp():\n\n            left = parse_xor()\n\n            if peek()[0] == \"→\":\n\n                consume()\n\n                return FOLNode(\n                    \"IMP\",\n                    children=[left, parse_imp()]\n                )\n\n            return left\n\n        def parse_xor():\n\n            node = parse_or()\n\n            while peek()[0] == \"⊕\":\n\n                consume()\n\n                node = FOLNode(\n                    \"XOR\",\n                    children=[node, parse_or()]\n                )\n\n            return node\n\n        def parse_or():\n\n            node = parse_and()\n\n            while peek()[0] == \"∨\":\n\n                consume()\n\n                node = FOLNode(\n                    \"OR\",\n                    children=[node, parse_and()]\n                )\n\n            return node\n\n        def parse_and():\n\n            node = parse_unary()\n\n            while peek()[0] == \"∧\":\n\n                consume()\n\n                node = FOLNode(\n                    \"AND\",\n                    children=[node, parse_unary()]\n                )\n\n            return node\n\n        def parse_unary():\n\n            token_type, token_value = peek()\n\n            if token_type == \"¬\":\n\n                consume()\n\n                return FOLNode(\n                    \"NOT\",\n                    children=[parse_unary()]\n                )\n\n            if token_type == \"QUANT\":\n\n                consume()\n\n                quantifier, variable = token_value\n\n                return FOLNode(\n                    \"ALL\" if quantifier == \"∀\" else \"EXISTS\",\n                    children=[parse_unary()],\n                    var=variable\n                )\n\n            if token_type == \"(\":\n\n                consume(\"(\")\n\n                node = parse_iff()\n\n                consume(\")\")\n\n                return node\n\n            if token_type == \"ID\":\n\n                identifier = consume(\"ID\")[1]\n\n                lowered = identifier.lower()\n\n                if lowered == \"true\":\n\n                    return FOLNode(\"BOOL\", val=True)\n\n                if lowered == \"false\":\n\n                    return FOLNode(\"BOOL\", val=False)\n\n                args = []\n\n                if peek()[0] == \"(\":\n\n                    consume(\"(\")\n\n                    if peek()[0] != \")\":\n\n                        while True:\n\n                            arg_type, arg_value = peek()\n\n                            if arg_type != \"ID\":\n\n                                raise ValueError(\n                                    \"Expected term in argument list, \"\n                                    f\"found {arg_type}\"\n                                )\n\n                            args.append(\n                                consume(\"ID\")[1].lower()\n                            )\n\n                            if peek()[0] == \",\":\n\n                                consume(\",\")\n\n                                continue\n\n                            break\n\n                    consume(\")\")\n\n                return FOLNode(\n                    \"ATOM\",\n                    val=(lowered, tuple(args))\n                )\n\n            raise ValueError(\n                f\"Unexpected token {token_type} in {text!r}\"\n            )\n\n        result = parse_iff()\n\n        if pos != len(tokens):\n\n            raise ValueError(\n                f\"Unparsed trailing tokens in {text!r}: \"\n                f\"{tokens[pos:]}\"\n            )\n\n        return result\n\n    # --------------------------------------------------------\n    # 2.4 Collect predicates and constants\n    # --------------------------------------------------------\n\n    @classmethod\n    def collect_signature(cls, nodes):\n\n        predicates = set()\n        constants = set()\n\n        def visit(node, bound):\n\n            if node.kind in (\"ALL\", \"EXISTS\"):\n\n                visit(\n                    node.children[0],\n                    bound | {node.var}\n                )\n\n            elif node.kind == \"ATOM\":\n\n                pred, args = node.val\n\n                if pred == \"equal\" and len(args) == 2:\n\n                    for arg in args:\n\n                        if (\n                            arg not in bound\n                            and arg not in cls.DEFAULT_VARS\n                        ):\n\n                            constants.add(arg)\n\n                else:\n\n                    predicates.add((pred, len(args)))\n\n                    for arg in args:\n\n                        if (\n                            arg not in bound\n                            and arg not in cls.DEFAULT_VARS\n                        ):\n\n                            constants.add(arg)\n\n            else:\n\n                for child in node.children:\n\n                    visit(child, bound)\n\n        for node in nodes:\n\n            visit(node, set())\n\n        return predicates, constants\n\n    # --------------------------------------------------------\n    # 2.5 Conservative fuzzy alignment\n    # --------------------------------------------------------\n\n    @classmethod\n    def align_node_with_kb(\n        cls,\n        node,\n        kb_predicates,\n        kb_constants\n    ):\n\n        if node.kind == \"ATOM\":\n\n            pred, args = node.val\n\n            aligned_args = []\n\n            for arg in args:\n\n                if (\n                    arg in kb_constants\n                    or arg in cls.DEFAULT_VARS\n                ):\n\n                    aligned_args.append(arg)\n\n                    continue\n\n                best_constant = arg\n                best_score = 0.0\n\n                for candidate in sorted(kb_constants):\n\n                    score = SequenceMatcher(\n                        None,\n                        arg,\n                        candidate\n                    ).ratio()\n\n                    if score > best_score:\n\n                        best_constant = candidate\n                        best_score = score\n\n                aligned_args.append(\n                    best_constant\n                    if best_score >= 0.72\n                    else arg\n                )\n\n            if (\n                pred != \"equal\"\n                and (pred, len(aligned_args)) not in kb_predicates\n            ):\n\n                best_predicate = pred\n                best_score = 0.0\n\n                for candidate, arity in sorted(kb_predicates):\n\n                    if arity != len(aligned_args):\n                        continue\n\n                    score = SequenceMatcher(\n                        None,\n                        pred,\n                        candidate\n                    ).ratio()\n\n                    if score > best_score:\n\n                        best_predicate = candidate\n                        best_score = score\n\n                if best_score >= 0.68:\n\n                    pred = best_predicate\n\n            return FOLNode(\n                \"ATOM\",\n                val=(pred, tuple(aligned_args))\n            )\n\n        if node.kind == \"BOOL\":\n\n            return node\n\n        return FOLNode(\n            node.kind,\n            node.val,\n            [\n                cls.align_node_with_kb(\n                    child,\n                    kb_predicates,\n                    kb_constants\n                )\n                for child in node.children\n            ],\n            node.var\n        )\n\n    # --------------------------------------------------------\n    # 2.6 Translate AST into Z3\n    # --------------------------------------------------------\n\n    @staticmethod\n    def _translate(\n        node,\n        sort,\n        predicates,\n        constants,\n        env,\n        fresh_counter\n    ):\n\n        kind = node.kind\n\n        if kind == \"BOOL\":\n\n            return z3.BoolVal(bool(node.val))\n\n        if kind == \"ATOM\":\n\n            predicate, args = node.val\n\n            if predicate == \"equal\":\n\n                if len(args) != 2:\n\n                    raise ValueError(\n                        \"Equal must have exactly two arguments\"\n                    )\n\n                left = FOLIOProver._term(\n                    args[0], sort, constants, env\n                )\n\n                right = FOLIOProver._term(\n                    args[1], sort, constants, env\n                )\n\n                return left == right\n\n            terms = [\n                FOLIOProver._term(\n                    arg, sort, constants, env\n                )\n                for arg in args\n            ]\n\n            key = (predicate, len(terms))\n\n            if key not in predicates:\n\n                if len(terms) == 0:\n\n                    predicates[key] = z3.Bool(\n                        f\"pred_{predicate}_0\"\n                    )\n\n                else:\n\n                    predicates[key] = z3.Function(\n                        f\"pred_{predicate}_{len(terms)}\",\n                        *([sort] * len(terms)),\n                        z3.BoolSort()\n                    )\n\n            if not terms:\n\n                return predicates[key]\n\n            return predicates[key](*terms)\n\n        if kind == \"NOT\":\n\n            return z3.Not(\n                FOLIOProver._translate(\n                    node.children[0],\n                    sort,\n                    predicates,\n                    constants,\n                    env,\n                    fresh_counter\n                )\n            )\n\n        if kind in (\"AND\", \"OR\", \"IMP\", \"IFF\", \"XOR\"):\n\n            left = FOLIOProver._translate(\n                node.children[0],\n                sort,\n                predicates,\n                constants,\n                env,\n                fresh_counter\n            )\n\n            right = FOLIOProver._translate(\n                node.children[1],\n                sort,\n                predicates,\n                constants,\n                env,\n                fresh_counter\n            )\n\n            if kind == \"AND\":\n\n                return z3.And(left, right)\n\n            if kind == \"OR\":\n\n                return z3.Or(left, right)\n\n            if kind == \"IMP\":\n\n                return z3.Implies(left, right)\n\n            if kind == \"IFF\":\n\n                return left == right\n\n            return z3.Xor(left, right)\n\n        if kind in (\"ALL\", \"EXISTS\"):\n\n            fresh_counter[0] += 1\n\n            variable = z3.Const(\n                f\"bound_{node.var}_{fresh_counter[0]}\",\n                sort\n            )\n\n            new_env = dict(env)\n\n            new_env[node.var] = variable\n\n            body = FOLIOProver._translate(\n                node.children[0],\n                sort,\n                predicates,\n                constants,\n                new_env,\n                fresh_counter\n            )\n\n            if kind == \"ALL\":\n\n                return z3.ForAll([variable], body)\n\n            return z3.Exists([variable], body)\n\n        raise ValueError(\n            f\"Unsupported AST node: {kind}\"\n        )\n\n    # --------------------------------------------------------\n    # 2.7 Resolve constants and variables\n    # --------------------------------------------------------\n\n    @staticmethod\n    def _term(name, sort, constants, env):\n\n        if name in env:\n\n            return env[name]\n\n        if name not in constants:\n\n            constants[name] = z3.Const(\n                f\"const_{name}\",\n                sort\n            )\n\n        return constants[name]\n\n    # --------------------------------------------------------\n    # 2.8 Main entailment procedure\n    # --------------------------------------------------------\n\n    def prove_folio_detailed(\n        self,\n        premises_fol_str,\n        conclusion_fol_str\n    ):\n\n        self.last_status = \"not_run\"\n        self.last_reason = \"\"\n        self.last_solver_reason = \"\"\n\n        if (\n            not str(premises_fol_str).strip()\n            or not str(conclusion_fol_str).strip()\n        ):\n\n            self.last_status = \"parse_error\"\n            self.last_reason = (\n                \"Missing premises or conclusion\"\n            )\n\n            return False, self.last_status\n\n        try:\n\n            premise_lines = [\n                line.strip()\n                for line in str(premises_fol_str).splitlines()\n                if line.strip()\n            ]\n\n            premise_nodes = [\n                self.parse_formula(line)\n                for line in premise_lines\n            ]\n\n            conclusion_node = self.parse_formula(\n                str(conclusion_fol_str).strip()\n            )\n\n            kb_predicates, kb_constants = (\n                self.collect_signature(premise_nodes)\n            )\n\n            if self.fuzzy_alignment:\n\n                conclusion_node = self.align_node_with_kb(\n                    conclusion_node,\n                    kb_predicates,\n                    kb_constants\n                )\n\n            domain_sort = z3.DeclareSort(\n                \"FOLIO_Domain\"\n            )\n\n            predicates = {}\n            constants = {}\n            fresh_counter = [0]\n\n            translated_premises = [\n                self._translate(\n                    node,\n                    domain_sort,\n                    predicates,\n                    constants,\n                    {},\n                    fresh_counter\n                )\n                for node in premise_nodes\n            ]\n\n            translated_conclusion = self._translate(\n                conclusion_node,\n                domain_sort,\n                predicates,\n                constants,\n                {},\n                fresh_counter\n            )\n\n            # First solver: check premise consistency.\n            kb_solver = z3.Solver()\n\n            kb_solver.set(timeout=self.timeout_ms)\n            kb_solver.set(mbqi=True)\n\n            kb_solver.add(*translated_premises)\n\n            kb_result = kb_solver.check()\n\n            if kb_result == z3.unsat:\n\n                self.last_status = \"inconsistent_kb\"\n                self.last_reason = (\n                    \"Premises are inconsistent\"\n                )\n\n                return False, self.last_status\n\n            if kb_result == z3.unknown:\n\n                self.last_status = \"unknown_kb\"\n\n                self.last_solver_reason = (\n                    kb_solver.reason_unknown()\n                )\n\n                self.last_reason = (\n                    \"Z3 could not determine premise consistency\"\n                )\n\n                return False, self.last_status\n\n            # Second solver: test entailment.\n            entailment_solver = z3.Solver()\n\n            entailment_solver.set(timeout=self.timeout_ms)\n            entailment_solver.set(mbqi=True)\n\n            entailment_solver.add(\n                *translated_premises\n            )\n\n            entailment_solver.add(\n                z3.Not(translated_conclusion)\n            )\n\n            result = entailment_solver.check()\n\n            if result == z3.unsat:\n\n                self.last_status = \"entailed\"\n\n                return True, self.last_status\n\n            if result == z3.sat:\n\n                self.last_status = \"not_entailed\"\n\n                return False, self.last_status\n\n            self.last_status = \"unknown\"\n\n            self.last_solver_reason = (\n                entailment_solver.reason_unknown()\n            )\n\n            self.last_reason = (\n                \"Z3 returned unknown; conservatively mapped to False\"\n            )\n\n            return False, self.last_status\n\n        except Exception as exc:\n\n            self.last_status = \"parse_or_translation_error\"\n\n            self.last_reason = repr(exc)\n\n            return False, self.last_status\n\n    def prove_folio(\n        self,\n        premises_fol_str,\n        conclusion_fol_str\n    ):\n\n        prediction, _ = self.prove_folio_detailed(\n            premises_fol_str,\n            conclusion_fol_str\n        )\n\n        return prediction\n\n\n# ============================================================\n# 3. CONSERVATIVE PARSER RECOVERY\n# ============================================================\n#\n# Only attempts to close unmatched parentheses at end-of-input.\n#\n# Does not modify:\n# - Logical operators\n# - Predicate names\n# - Arguments\n# - Variables\n# - Quantifier scopes\n# - Formula ordering\n#\n# Unrecoverable formulas remain parser errors.\n# ============================================================\n\nif \"FOLIO_PARSE_RECOVERY_COUNTS\" not in globals():\n\n    FOLIO_PARSE_RECOVERY_COUNTS = {\n        \"repaired\": 0,\n        \"unrepaired\": 0\n    }\n\nif \"FOLIO_PARSE_RECOVERY_LOG\" not in globals():\n\n    FOLIO_PARSE_RECOVERY_LOG = []\n\nif \"_FOLIO_PARSE_FORMULA_STRICT\" not in globals():\n\n    _FOLIO_PARSE_FORMULA_STRICT = (\n        FOLIOProver.parse_formula.__func__\n    )\n\n\ndef _folio_parse_formula_conservative(cls, text):\n\n    try:\n\n        return _FOLIO_PARSE_FORMULA_STRICT(\n            cls,\n            text\n        )\n\n    except ValueError as original_error:\n\n        error_text = str(original_error)\n\n        # Only recover missing closing parentheses at EOF.\n        if \"Expected ), found None\" not in error_text:\n\n            FOLIO_PARSE_RECOVERY_COUNTS[\n                \"unrepaired\"\n            ] += 1\n\n            raise\n\n        cleaned = cls.clean_fol_line(text)\n\n        balance = 0\n        minimum_balance = 0\n\n        for character in cleaned:\n\n            if character == \"(\":\n\n                balance += 1\n\n            elif character == \")\":\n\n                balance -= 1\n\n                minimum_balance = min(\n                    minimum_balance,\n                    balance\n                )\n\n        # Extra closing parentheses are not modified.\n        # Recovery is limited to 1–3 missing closing parentheses.\n        if (\n            minimum_balance < 0\n            or balance < 1\n            or balance > 3\n        ):\n\n            FOLIO_PARSE_RECOVERY_COUNTS[\n                \"unrepaired\"\n            ] += 1\n\n            raise original_error\n\n        repaired_text = cleaned + (\")\" * balance)\n\n        try:\n\n            parsed = _FOLIO_PARSE_FORMULA_STRICT(\n                cls,\n                repaired_text\n            )\n\n        except Exception:\n\n            FOLIO_PARSE_RECOVERY_COUNTS[\n                \"unrepaired\"\n            ] += 1\n\n            raise original_error\n\n        FOLIO_PARSE_RECOVERY_COUNTS[\n            \"repaired\"\n        ] += 1\n\n        FOLIO_PARSE_RECOVERY_LOG.append({\n\n            \"original\": cleaned,\n\n            \"repaired\": repaired_text,\n\n            \"added_closing_parentheses\": balance\n\n        })\n\n        return parsed\n\n\nFOLIOProver.parse_formula = classmethod(\n    _folio_parse_formula_conservative\n)\n\nprint(\n    \"Conservative FOLIO parser recovery enabled.\"\n)\n\n\n# ============================================================\n# 4. LABEL MAPPING\n# ============================================================\n\ndef folio_gold_binary(label):\n\n    \"\"\"True -> True; False/Uncertain -> False.\"\"\"\n\n    return (\n        str(label).strip().lower() == \"true\"\n    )\n\n\n# ============================================================\n# 5. FOLIO EVALUATION FUNCTION\n# ============================================================\n\ndef evaluate_folio_split(\n    dataframe,\n    split_name,\n    output_dir,\n    timeout_ms=8000,\n    fuzzy_alignment=True\n):\n\n    from sklearn.metrics import (\n        accuracy_score,\n        precision_score,\n        recall_score,\n        f1_score,\n        confusion_matrix,\n        classification_report\n    )\n\n    prover = FOLIOProver(\n        timeout_ms=timeout_ms,\n        fuzzy_alignment=fuzzy_alignment\n    )\n\n    y_true = []\n    y_pred = []\n\n    records = []\n\n    statuses = Counter()\n\n    start = time.perf_counter()\n\n    for index, row in dataframe.iterrows():\n\n        pred, status = prover.prove_folio_detailed(\n            row[\"premises-FOL\"],\n            row[\"conclusion-FOL\"]\n        )\n\n        gold = folio_gold_binary(\n            row[\"label\"]\n        )\n\n        statuses[status] += 1\n\n        y_true.append(gold)\n        y_pred.append(bool(pred))\n\n        records.append({\n\n            \"example_id\": row.get(\n                \"example_id\",\n                index\n            ),\n\n            \"story_id\": row.get(\n                \"story_id\",\n                \"\"\n            ),\n\n            \"original_label\": row[\"label\"],\n\n            \"gold_binary\": gold,\n\n            \"predicted_label\": bool(pred),\n\n            \"correct\": bool(pred) == gold,\n\n            \"solver_status\": status,\n\n            \"solver_reason\": prover.last_solver_reason,\n\n            \"error_reason\": prover.last_reason,\n\n            \"conclusion_FOL\": row[\"conclusion-FOL\"]\n\n        })\n\n    elapsed = time.perf_counter() - start\n\n    metrics = {\n\n        \"split\": split_name,\n\n        \"examples\": len(y_true),\n\n        \"accuracy\": (\n            accuracy_score(y_true, y_pred)\n            if y_true else 0.0\n        ),\n\n        \"precision\": (\n            precision_score(\n                y_true,\n                y_pred,\n                zero_division=0\n            )\n            if y_true else 0.0\n        ),\n\n        \"recall\": (\n            recall_score(\n                y_true,\n                y_pred,\n                zero_division=0\n            )\n            if y_true else 0.0\n        ),\n\n        \"f1\": (\n            f1_score(\n                y_true,\n                y_pred,\n                zero_division=0\n            )\n            if y_true else 0.0\n        ),\n\n        \"runtime_seconds\": elapsed,\n\n        \"status_counts\": dict(statuses),\n\n        \"confusion_matrix\": (\n            confusion_matrix(\n                y_true,\n                y_pred\n            ).tolist()\n            if y_true else []\n        )\n\n    }\n\n    os.makedirs(\n        output_dir,\n        exist_ok=True\n    )\n\n    prediction_path = os.path.join(\n        output_dir,\n        f\"folio_{split_name.lower()}_predictions.csv\"\n    )\n\n    predictions_df = pd.DataFrame(records)\n\n    predictions_df.to_csv(\n        prediction_path,\n        index=False\n    )\n\n    print(\"\\n\" + \"=\" * 78)\n\n    print(\n        f\"FOLIO {split_name.upper()} — \"\n        \"Z3 FIRST-ORDER ENTAILMENT\"\n    )\n\n    print(\"=\" * 78)\n\n    print(\n        \"Examples:\",\n        metrics[\"examples\"]\n    )\n\n    print(\n        f\"Accuracy:  {metrics['accuracy']:.4f}\"\n    )\n\n    print(\n        f\"Precision: {metrics['precision']:.4f}\"\n    )\n\n    print(\n        f\"Recall:    {metrics['recall']:.4f}\"\n    )\n\n    print(\n        f\"F1-score:  {metrics['f1']:.4f}\"\n    )\n\n    print(\n        f\"Runtime:   {elapsed:.2f} seconds\"\n    )\n\n    print(\n        \"\\nSolver statuses:\",\n        dict(statuses)\n    )\n\n    print(\n        \"\\nConfusion matrix [ [TN, FP], [FN, TP] ]:\"\n    )\n\n    print(\n        metrics[\"confusion_matrix\"]\n    )\n\n    print(\"\\nClassification report:\")\n\n    print(\n        classification_report(\n            y_true,\n            y_pred,\n            target_names=[\"False\", \"True\"],\n            zero_division=0\n        )\n    )\n\n    print(\n        \"\\nPredictions saved:\",\n        prediction_path\n    )\n\n    return metrics, predictions_df\n\n\n# ============================================================\n# 6. KAGGLE DATA AND OUTPUT PATHS\n# ============================================================\n\nDATA_DIR = (\n    \"/kaggle/working/AI_Assignment_2026/\"\n    \"data/normalized\"\n)\n\nOUTPUT_DIR = (\n    \"/kaggle/working/AI_Assignment_2026/\"\n    \"outputs\"\n)\n\nos.makedirs(\n    OUTPUT_DIR,\n    exist_ok=True\n)\n\n\n# ============================================================\n# 7. LOAD FOLIO DATA\n# ============================================================\n\nif \"folio_train_df\" in globals():\n\n    _folio_train_df = folio_train_df\n\nelif \"FOLIO_TRAIN\" in globals():\n\n    _folio_train_df = FOLIO_TRAIN\n\nelse:\n\n    _folio_train_path = os.path.join(\n        DATA_DIR,\n        \"folio_train.jsonl\"\n    )\n\n    _folio_train_df = pd.read_json(\n        _folio_train_path,\n        lines=True\n    )\n\n\nif \"folio_validation_df\" in globals():\n\n    _folio_validation_df = folio_validation_df\n\nelif \"FOLIO_VALIDATION\" in globals():\n\n    _folio_validation_df = FOLIO_VALIDATION\n\nelse:\n\n    _folio_validation_path = os.path.join(\n        DATA_DIR,\n        \"folio_validation.jsonl\"\n    )\n\n    _folio_validation_df = pd.read_json(\n        _folio_validation_path,\n        lines=True\n    )\n\n\n# ============================================================\n# 8. VERIFY INPUT DATA\n# ============================================================\n\n_required_folio_columns = {\n\n    \"premises-FOL\",\n\n    \"conclusion-FOL\",\n\n    \"label\"\n\n}\n\nfor _split_name, _split_df in [\n\n    (\"train\", _folio_train_df),\n\n    (\"validation\", _folio_validation_df)\n\n]:\n\n    _missing = (\n        _required_folio_columns\n        - set(_split_df.columns)\n    )\n\n    if _missing:\n\n        raise ValueError(\n            f\"FOLIO {_split_name} is missing required \"\n            f\"columns: {sorted(_missing)}\"\n        )\n\n\n# ================================