(frozen=True)\nclass CausalMechanism:\n    parents: tuple\n    parent_operator: str\n    child: str\n    child_value: bool = True\n    parent_values: tuple = ()\n\n    def __post_init__(self):\n        object.__setattr__(self, \"parents\", tuple(normalize_variable(x) for x in self.parents))\n        object.__setattr__(self, \"child\", normalize_variable(self.child))\n        object.__setattr__(self, \"parent_operator\", self.parent_operator.upper())\n        values = self.parent_values or tuple(True for _ in self.parents)\n        object.__setattr__(self, \"parent_values\", tuple(bool(v) for v in values))\n        if self.parent_operator not in {\"AND\", \"OR\"}:\n            raise ValueError(\"parent_operator must be AND or OR\")\n        if not self.parents:\n            raise ValueError(\"A causal mechanism needs at least one parent\")\n        if len(self.parents) != len(self.parent_values):\n            raise ValueError(\"parent_values must match parents length\")\n\n\n# ------------------------------------------------------------\n# 10.3 Causal statement patterns\n# ------------------------------------------------------------\n\nCOMBINATION_CAUSE_PATTERN = re.compile(\n    rf\"^\\s*({VARIABLE})\\s+(and|or)\\s+({VARIABLE})\"\n    rf\"(?:\\s+together)?\\s+causes?\\s+(not\\s+)?({VARIABLE})\\s*$\",\n    re.IGNORECASE\n)\n\nMULTIPLE_EFFECT_PATTERN = re.compile(\n    rf\"^\\s*({VARIABLE})\\s+causes?\\s+(.+?)\\s*$\",\n    re.IGNORECASE\n)\n\n\n# ------------------------------------------------------------\n# 10.4 Helpers for causal statement parsing\n# ------------------------------------------------------------\n\ndef normalize_variable(name):\n    return name.strip().lower()\n\n\ndef parse_effect_list(effect_text):\n    \"\"\"\n    Parse effects such as:\n        Blaf\n        not Blaf\n        Blaf and Vork\n        Blaf, Trune and Vork\n    \"\"\"\n\n    parts = re.split(\n        r\"\\s*,\\s*|\\s+and\\s+\",\n        effect_text.strip(),\n        flags=re.IGNORECASE\n    )\n\n    effects = []\n\n    for part in parts:\n        part = part.strip().strip(\".;\")\n\n        match = re.fullmatch(\n            rf\"(not\\s+)?({VARIABLE})\",\n            part,\n            re.IGNORECASE\n        )\n\n        if match:\n            negation, variable = match.groups()\n\n            effects.append(\n                (\n                    normalize_variable(variable),\n                    not bool(negation)\n                )\n            )\n\n    return effects\n\n\n# ------------------------------------------------------------\n# 10.5 Parse causal mechanisms\n# ------------------------------------------------------------\n\ndef parse_causal_mechanisms(given_info):\n    \"\"\"\n    Supported patterns:\n      A causes B\n      A causes not B\n      A and B together cause C\n      A and B cause C\n      A or B causes C\n      A causes B and C\n      A causes B, C and D\n    \"\"\"\n\n    mechanisms = []\n\n    if not isinstance(given_info, str):\n        return mechanisms\n\n    statements = re.split(r\"[\\n;]+\", given_info)\n\n    for statement in statements:\n        statement = statement.strip().strip(\".\")\n\n        if not statement:\n            continue\n\n        # Multiple antecedents: AND / OR\n        match = COMBINATION_CAUSE_PATTERN.match(statement)\n\n        if match:\n            parent1, operator, parent2, negation, child = match.groups()\n\n            mechanisms.append(\n                CausalMechanism(\n                    parents=(\n                        normalize_variable(parent1),\n                        normalize_variable(parent2)\n                    ),\n                    parent_operator=operator.upper(),\n                    child=normalize_variable(child),\n                    child_value=not bool(negation)\n                )\n            )\n            continue\n\n        # Single antecedent with one or multiple effects\n        match = MULTIPLE_EFFECT_PATTERN.match(statement)\n\n        if match:\n            parent, effect_text = match.groups()\n\n            effects = parse_effect_list(effect_text)\n\n            for child, child_value in effects:\n                mechanisms.append(\n                    CausalMechanism(\n                        parents=(normalize_variable(parent),),\n                        parent_operator=\"AND\",\n                        child=child,\n                        child_value=child_value\n                    )\n                )\n\n    return mechanisms\n\n\n# ------------------------------------------------------------\n# 10.6 Intervention representation\n# ------------------------------------------------------------\n\n@dataclass(frozen=True)\nclass Intervention:\n    variable: str\n    value: bool\n\n\n@dataclass(frozen=True)\nclass CounterfactualQuery:\n    outcome: str\n    interventions: tuple\n    query_type: str\n\n\n# ------------------------------------------------------------\n# 10.7 Intervention parser\n# ------------------------------------------------------------\n\nINTERVENTION_PATTERN = re.compile(\n    rf\"\\b(not\\s+)?({VARIABLE})\\b\",\n    re.IGNORECASE\n)\n\n\ndef extract_interventions(text):\n    \"\"\"\n    Extract intervention variables and their assumed values.\n\n    Examples:\n        not Ziklo -> Ziklo = False\n        not Ziklo and not Blaf -> both False\n        if not Ziklo instead of Ziklo -> only Ziklo = False\n    \"\"\"\n\n    if not isinstance(text, str):\n        return tuple()\n\n    # Remove baseline comparison.\n    text = re.split(\n        r\"\\binstead\\s+of\\b\",\n        text,\n        maxsplit=1,\n        flags=re.IGNORECASE\n    )[0]\n\n    # Remove leading 'if'.\n    text = re.sub(\n        r\"^\\s*if\\s+\",\n        \"\",\n        text,\n        flags=re.IGNORECASE\n    )\n\n    interventions = []\n\n    for match in INTERVENTION_PATTERN.finditer(text):\n        negation, variable = match.groups()\n\n        variable = normalize_variable(variable)\n\n        if variable in STOP_WORDS:\n            continue\n\n        interventions.append(\n            Intervention(\n                variable=variable,\n                value=not bool(negation)\n            )\n        )\n\n    # Remove duplicates, preserving order.\n    unique = []\n    seen = set()\n\n    for intervention in interventions:\n        if intervention.variable not in seen:\n            unique.append(intervention)\n            seen.add(intervention.variable)\n\n    return tuple(unique)\n\n\n# ------------------------------------------------------------\n# 10.8 Counterfactual question patterns\n# ------------------------------------------------------------\n\nSINGLE_QUERY_PATTERN = re.compile(\n    rf\"\\bWould\\s+({VARIABLE})\\s+occur\\s+if\\s+(.+?)\\?\",\n    re.IGNORECASE | re.DOTALL\n)\n\nDIRECT_QUERY_PATTERN = re.compile(\n    rf\"\\bWould\\s+({VARIABLE})\\s+occur\\?\",\n    re.IGNORECASE\n)\n\n\n# ------------------------------------------------------------\n# 10.9 Parse counterfactual questions\n# ------------------------------------------------------------\n\ndef parse_counterfactual_question(question):\n    \"\"\"\n    Parse:\n      1. Basic counterfactual questions\n      2. Joint intervention questions\n      3. Nested assumption questions\n      4. Direct outcome questions\n    \"\"\"\n\n    if not isinstance(question, str):\n        return None\n\n    question = question.strip()\n\n    # --------------------------------------------------------\n    # Case 1: Nested assumptions\n    #\n    # Example:\n    # Assume not Ziklo, and based on this assumption,\n    # further suppose not Sline. Would Lumbo occur?\n    # --------------------------------------------------------\n\n    nested_match = re.search(\n        r\"\\bAssume\\s+(.+?),\\s*\"\n        r\"and\\s+based\\s+on\\s+this\\s+assumption,\\s*\"\n        r\"further\\s+suppose\\s+(.+?)\\.\\s*\"\n        r\"Would\\s+([A-Za-z][A-Za-z0-9_-]*)\\s+occur\\?\",\n        question,\n        re.IGNORECASE | re.DOTALL\n    )\n\n    if nested_match:\n        first_assumption = nested_match.group(1).strip()\n        second_assumption = nested_match.group(2).strip()\n        outcome = nested_match.group(3)\n\n        first_interventions = extract_interventions(first_assumption)\n        second_interventions = extract_interventions(second_assumption)\n\n        combined = list(first_interventions) + list(second_interventions)\n\n        unique = []\n        seen = set()\n\n        for intervention in combined:\n            if intervention.variable not in seen:\n                unique.append(intervention)\n                seen.add(intervention.variable)\n\n        if unique:\n            return CounterfactualQuery(\n                outcome=normalize_variable(outcome),\n                interventions=tuple(unique),\n                query_type=\"nested\"\n            )\n\n    # --------------------------------------------------------\n    # Case 2: Basic or joint counterfactual\n    # --------------------------------------------------------\n\n    single_match = SINGLE_QUERY_PATTERN.search(question)\n\n    if single_match:\n        outcome, intervention_text = single_match.groups()\n\n        interventions = extract_interventions(intervention_text)\n\n        if interventions:\n            query_type = (\n                \"joint\" if len(interventions) > 1 else \"single\"\n            )\n\n            return CounterfactualQuery(\n                outcome=normalize_variable(outcome),\n                interventions=interventions,\n                query_type=query_type\n            )\n\n    # --------------------------------------------------------\n    # Case 3: Direct question\n    # --------------------------------------------------------\n\n    direct_match = DIRECT_QUERY_PATTERN.search(question)\n\n    if direct_match:\n        return CounterfactualQuery(\n            outcome=normalize_variable(direct_match.group(1)),\n            interventions=tuple(),\n            query_type=\"direct\"\n        )\n\n    return None\n\n\n# ------------------------------------------------------------\n# 10.10 Causal mechanism parser tests\n# ------------------------------------------------------------\n\ncausal_test_cases = [\n    (\n        \"Ziklo causes Blaf\",\n        [(\"ziklo\", \"AND\", \"blaf\", True)]\n    ),\n    (\n        \"Ziklo causes not Blaf\",\n        [(\"ziklo\", \"AND\", \"blaf\", False)]\n    ),\n    (\n        \"Blaf and Trune together cause Vork\",\n        [(\"blaf\", \"AND\", \"vork\", True)]\n    ),\n    (\n        \"Trune or Vork causes Lumbo\",\n        [(\"trune\", \"OR\", \"lumbo\", True)]\n    ),\n    (\n        \"Ziklo causes Blaf and Vork\",\n        [\n            (\"ziklo\", \"AND\", \"blaf\", True),\n            (\"ziklo\", \"AND\", \"vork\", True)\n        ]\n    ),\n    (\n        \"Ziklo causes Blaf, Trune and Vork\",\n        [\n            (\"ziklo\", \"AND\", \"blaf\", True),\n            (\"ziklo\", \"AND\", \"trune\", True),\n            (\"ziklo\", \"AND\", \"vork\", True)\n        ]\n    )\n]\n\nfor statement, expected in causal_test_cases:\n    parsed = parse_causal_mechanisms(statement)\n\n    actual = [\n        (\n            mechanism.parents[0],\n            mechanism.parent_operator,\n            mechanism.child,\n            mechanism.child_value\n        )\n        for mechanism in parsed\n    ]\n\n    assert actual == expected, (\n        f\"Causal parser failed for: {statement}\\n\"\n        f\"Expected: {expected}\\nActual: {actual}\"\n    )\n\nprint(\"Causal mechanism parser tests: PASSED\")\n\n\n# ------------------------------------------------------------\n# 10.11 Intervention parser tests\n# ------------------------------------------------------------\n\nintervention_tests = [\n    (\"not Ziklo\", [(\"ziklo\", False)]),\n    (\n        \"not Ziklo and not Blaf\",\n        [(\"ziklo\", False), (\"blaf\", False)]\n    ),\n    (\n        \"if not Ziklo instead of Ziklo\",\n        [(\"ziklo\", False)]\n    ),\n    (\n        \"if not Ziklo and not Blaf\",\n        [(\"ziklo\", False), (\"blaf\", False)]\n    )\n]\n\nfor text, expected in intervention_tests:\n    parsed = extract_interventions(text)\n\n    actual = [\n        (item.variable, item.value)\n        for item in parsed\n    ]\n\n    assert actual == expected, (\n        f\"Intervention parser failed for: {text}\\n\"\n        f\"Expected: {expected}\\nActual: {actual}\"\n    )\n\nprint(\"Intervention parser tests: PASSED\")\n\n\n# ------------------------------------------------------------\n# 10.12 Counterfactual question parser tests\n# ------------------------------------------------------------\n\nquestion_tests = [\n    (\n        \"Would Lumbo occur if not Ziklo instead of Ziklo?\",\n        \"lumbo\",\n        [(\"ziklo\", False)],\n        \"single\"\n    ),\n    (\n        \"Would Lumbo occur if not Ziklo and not Blaf?\",\n        \"lumbo\",\n        [(\"ziklo\", False), (\"blaf\", False)],\n        \"joint\"\n    ),\n    (\n        \"Assume not Ziklo, and based on this assumption, \"\n        \"further suppose not Sline. Would Lumbo occur?\",\n        \"lumbo\",\n        [(\"ziklo\", False), (\"sline\", False)],\n        \"nested\"\n    )\n]\n\nfor question, expected_outcome, expected_interventions, expected_type in question_tests:\n    parsed = parse_counterfactual_question(question)\n\n    assert parsed is not None, (\n        f\"Question parser returned None: {question}\"\n    )\n\n    actual_interventions = [\n        (item.variable, item.value)\n        for item in parsed.interventions\n    ]\n\n    assert parsed.outcome == expected_outcome, (\n        f\"Incorrect outcome for: {question}\"\n    )\n\n    assert actual_interventions == expected_interventions, (\n        f\"Incorrect interventions for: {question}\\n\"\n        f\"Expected: {expected_interventions}\\n\"\n        f\"Actual: {actual_interventions}\"\n    )\n\n    assert parsed.query_type == expected_type, (\n        f\"Incorrect query type for: {question}\"\n    )\n\nprint(\"Counterfactual question parser tests: PASSED\")\n\n\n# ------------------------------------------------------------\n# 10.13 Load normalized CounterBench datasets\n# ------------------------------------------------------------\n\ndef load_jsonl(path):\n    records = []\n\n    with open(path, \"r\", encoding=\"utf-8\") as file:\n        for line in file:\n            if line.strip():\n                records.append(json.loads(line))\n\n    return records\n\n\nalpha_path = NORMALIZED_DIR / \"counterbench_alpha.jsonl\"\nbackdoor_path = NORMALIZED_DIR / \"counterbench_backdoor.jsonl\"\n\nassert alpha_path.exists(), f\"Missing file: {alpha_path}\"\nassert backdoor_path.exists(), f\"Missing file: {backdoor_path}\"\n\nalpha_records = load_jsonl(alpha_path)\nbackdoor_records = load_jsonl(backdoor_path)\n\n\n# ------------------------------------------------------------\n# 10.14 Dataset parser coverage validation\n# ------------------------------------------------------------\n\ndef validate_counterbench_parser(records, dataset_name):\n    parsed_count = 0\n    failed_questions = []\n    type_counts = Counter()\n\n    for record in records:\n        question = record.get(\"question\", \"\")\n\n        parsed = parse_counterfactual_question(question)\n\n        if parsed is not None:\n            parsed_count += 1\n            type_counts[parsed.query_type] += 1\n        else:\n            failed_questions.append({\n                \"question_id\": record.get(\"question_id\"),\n                \"question\": question,\n                \"type\": record.get(\"type\")\n            })\n\n    total = len(records)\n    coverage = parsed_count / total * 100 if total else 0\n\n    print(f\"\\n{dataset_name}\")\n    print(\"-\" * 50)\n    print(f\"Total questions: {total}\")\n    print(f\"Successfully parsed: {parsed_count}\")\n    print(f\"Failed questions: {len(failed_questions)}\")\n    print(f\"Parser coverage: {coverage:.2f}%\")\n    print(f\"Parsed question types: {dict(type_counts)}\")\n\n    return {\n        \"dataset\": dataset_name,\n        \"total\": total,\n        \"parsed\": parsed_count,\n        \"failed\": len(failed_questions),\n        \"coverage_percent\": round(coverage, 2),\n        \"type_counts\": dict(type_counts),\n        \"failed_questions\": failed_questions\n    }\n\n\nalpha_stats = validate_counterbench_parser(\n    alpha_records,\n    \"CounterBench Alpha\"\n)\n\nbackdoor_stats = validate_counterbench_parser(\n    backdoor_records,\n    \"CounterBench Backdoor\"\n)\n\n\n# ------------------------------------------------------------\n# 10.15 Save validation results\n# ------------------------------------------------------------\n\nparser_validation = {\n    \"causal_mechanism_tests\": \"passed\",\n    \"intervention_parser_tests\": \"passed\",\n    \"question_parser_tests\": \"passed\",\n    \"alpha\": alpha_stats,\n    \"backdoor\": backdoor_stats\n}\n\nvalidation_path = OUTPUT_DIR / \"counterbench_parser_validation.json\"\n\nwith open(validation_path, \"w\", encoding=\"utf-8\") as file:\n    json.dump(parser_validation, file, indent=2)\n\nprint(\"\\n\" + \"=\" * 60)\nprint(\"SECTION 10 COMPLETED\")\nprint(\"=\" * 60)\nprint(f\"Validation report saved to: {validation_path}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T12:40:35.410711Z","iopub.execute_input":"2026-11-17T12:40:35.41121Z","iopub.status.idle":"2026-11-17T12:40:35.509314Z","shell.execute_reply.started":"2026-11-17T12:40:35.411179Z","shell.execute_reply":"2026-11-17T12:40:35.508204Z"}},"outputs":[{"name":"stdout","text":"Causal mechanism parser tests: PASSED\nIntervention parser tests: PASSED\nCounterfactual question parser tests: PASSED\n\nCounterBench Alpha\n--------------------------------------------------\nTotal questions: 1000\nSuccessfully parsed: 1000\nFailed questions: 0\nParser coverage: 100.00%\nParsed question types: {'single': 500, 'joint': 250, 'nested': 250}\n\nCounterBench Backdoor\n--------------------------------------------------\nTotal questions: 200\nSuccessfully parsed: 200\nFailed questions: 0\nParser coverage: 100.00%\nParsed question types: {'single': 200}\n\n============================================================\nSECTION 10 COMPLETED\n============================================================\nValidation report saved to: /kaggle/working/AI_Assignment_2026/outputs/counterbench_parser_validation.json\n","output_type":"stream"}],"execution_count":9},{"cell_type":"code","source":"\n# ============================================================\n# SECTION 11: COUNTERBENCH CAUSAL REASONING ENGINE\n# ============================================================\n\nfrom dataclasses import dataclass, field\nfrom collections import defaultdict\nimport re\n\n\n# ------------------------------------------------------------\n# 11.1 Causal graph representation\n# ------------------------------------------------------------\n\n@dataclass\nclass CausalGraph:\n    mechanisms: list\n    variables: set = field(default_factory=set)\n\n    def __post_init__(self):\n        self.variables = set(self.variables)\n\n        for mechanism in self.mechanisms:\n            self.variables.update(mechanism.parents)\n            self.variables.add(mechanism.child)\n\n    def add_mechanism(self, mechanism):\n        self.mechanisms.append(mechanism)\n        self.variables.update(mechanism.parents)\n        self.variables.add(mechanism.child)\n\n    def summary(self):\n        return {\n            \"variables\": len(self.variables),\n            \"mechanisms\": len(self.mechanisms),\n            \"variables_list\": sorted(self.variables)\n        }\n\n\n# ------------------------------------------------------------\n# 11.2 Causal reasoning result\n# ------------------------------------------------------------\n\n@dataclass\nclass CausalReasoningResult:\n    state: dict\n    interventions: dict\n    derived_assignments: dict\n    conflicts: list\n    activated_mechanisms: list\n    iterations: int\n\n    def outcome(self, variable):\n        variable = normalize_variable(variable)\n        return self.state.get(variable, False)\n\n    @property\n    def consistent(self):\n        return len(self.conflicts) == 0\n\n\n\ndef mechanism_is_active(mechanism, state):\n    \"\"\"\n    Evaluate a causal mechanism using the required truth value\n    of each parent.\n\n    AND: every parent must match its required value.\n    OR: at least one parent must match its required value.\n    \"\"\"\n\n    parent_matches = [\n        state.get(parent, False) == required_value\n        for parent, required_value in zip(\n            mechanism.parents,\n            mechanism.parent_values\n        )\n    ]\n\n    if mechanism.parent_operator == \"AND\":\n        return all(parent_matches)\n\n    if mechanism.parent_operator == \"OR\":\n        return any(parent_matches)\n\n    raise ValueError(\n        f\"Unsupported operator: {mechanism.parent_operator}\"\n    )\n\n\ndef build_causal_graph(given_info):\n    \"\"\"\n    Convert causal statements into a CausalGraph.\n\n    Requires parse_causal_mechanisms() from Section 10,\n    redefined below with corrected sentence separation.\n    \"\"\"\n\n    mechanisms = parse_causal_mechanisms(given_info)\n\n    return CausalGraph(mechanisms=mechanisms)\n\n\n# ------------------------------------------------------------\n# 11.5 Normalize intervention inputs\n# ------------------------------------------------------------\n\ndef normalize_intervention_input(interventions):\n    \"\"\"\n    Accept either:\n        {\"ziklo\": False, \"blaf\": True}\n\n    or a list/tuple of Intervention objects.\n    \"\"\"\n\n    normalized = {}\n\n    if interventions is None:\n        return normalized\n\n    if isinstance(interventions, dict):\n        for variable, value in interventions.items():\n            normalized[normalize_variable(variable)] = bool(value)\n\n    else:\n        for intervention in interventions:\n            normalized[\n                normalize_variable(intervention.variable)\n            ] = bool(intervention.value)\n\n    return normalized\n\n\n# ------------------------------------------------------------\n# 11.6 Forward causal propagation\n# ------------------------------------------------------------\n\ndef simulate_causal_graph(\n    graph,\n    interventions=None,\n    initial_state=None,\n    max_iterations=100\n):\n    \"\"\"\n    Deterministic forward propagation.\n\n    Rules:\n      - All graph variables initially default to False.\n      - Initial assignments can set starting values.\n      - Interventions override initial assignments.\n      - Activated mechanisms propose consequent values.\n      - Explicit interventions take priority over causal effects.\n      - Conflicting causal effects are recorded.\n      - Each mechanism fires at most once.\n    \"\"\"\n\n    if not isinstance(graph, CausalGraph):\n        raise TypeError(\"graph must be a CausalGraph\")\n\n    intervention_map = normalize_intervention_input(interventions)\n\n    # Initialize variables.\n    state = {\n        variable: False\n        for variable in graph.variables\n    }\n\n    # Apply initial state.\n    if initial_state:\n        for variable, value in initial_state.items():\n            state[normalize_variable(variable)] = bool(value)\n\n    # Apply interventions after initial state.\n    for variable, value in intervention_map.items():\n        state[variable] = value\n\n    derived_assignments = {}\n    activated = set()\n    conflicts = []\n    conflict_keys = set()\n\n    iterations = 0\n\n    for iteration in range(max_iterations):\n        iterations = iteration + 1\n        new_effects = []\n\n        # Find newly activated mechanisms.\n        for mechanism_index, mechanism in enumerate(graph.mechanisms):\n\n            if mechanism_index in activated:\n                continue\n\n            if mechanism_is_active(mechanism, state):\n                activated.add(mechanism_index)\n\n                new_effects.append(\n                    (\n                        mechanism_index,\n                        mechanism.child,\n                        mechanism.child_value\n                    )\n                )\n\n        if not new_effects:\n            break\n\n        # Group proposed effects by consequent variable.\n        effects_by_child = defaultdict(list)\n\n        for mechanism_index, child, effect_value in new_effects:\n            effects_by_child[child].append(\n                (mechanism_index, effect_value)\n            )\n\n        # Resolve proposed effects.\n        for child, effects in effects_by_child.items():\n\n            # Interventions override causal effects.\n            if child in intervention_map:\n                continue\n\n            proposed_values = {\n                value for _, value in effects\n            }\n\n            # Simultaneous contradictory effects.\n            if len(proposed_values) > 1:\n                conflict_key = (\n                    child,\n                    tuple(sorted(proposed_values))\n                )\n\n                if conflict_key not in conflict_keys:\n                    conflicts.append({\n                        \"variable\": child,\n                        \"values\": sorted(proposed_values),\n                        \"mechanism_indices\": [\n                            index for index, _ in effects\n                        ]\n                    })\n                    conflict_keys.add(conflict_key)\n\n                continue\n\n            proposed_value = next(iter(proposed_values))\n\n            # Check for conflict with an earlier assignment.\n            if (\n                child in derived_assignments\n                and derived_assignments[child] != proposed_value\n            ):\n                conflict_key = (\n                    child,\n                    tuple(sorted({\n                        derived_assignments[child],\n                        proposed_value\n                    }))\n                )\n\n                if conflict_key not in conflict_keys:\n                    conflicts.append({\n                        \"variable\": child,\n                        \"values\": sorted({\n                            derived_assignments[child],\n                            proposed_value\n                        }),\n                        \"mechanism_indices\": [\n                            index for index, _ in effects\n                        ]\n                    })\n                    conflict_keys.add(conflict_key)\n\n                continue\n\n            derived_assignments[child] = proposed_value\n            state[child] = proposed_value\n\n    else:\n        raise RuntimeError(\n            \"Causal propagation exceeded the maximum iteration limit.\"\n        )\n\n    return CausalReasoningResult(\n        state=state,\n        interventions=intervention_map,\n        derived_assignments=derived_assignments,\n        conflicts=conflicts,\n        activated_mechanisms=sorted(activated),\n        iterations=iterations\n    )\n\n\n# ------------------------------------------------------------\n# 11.7 Counterfactual prediction\n# ------------------------------------------------------------\n\ndef predict_counterfactual(given_info, question):\n    \"\"\"\n    Predict the queried outcome under the specified interventions.\n    \"\"\"\n\n    mechanisms = parse_causal_mechanisms(given_info)\n    graph = CausalGraph(mechanisms=mechanisms)\n\n    parsed_question = parse_counterfactual_question(question)\n\n    if parsed_question is None:\n        raise ValueError(\n            f\"Could not parse counterfactual question: {question}\"\n        )\n\n    result = simulate_causal_graph(\n        graph=graph,\n        interventions=parsed_question.interventions\n    )\n\n    outcome = parsed_question.outcome\n\n    prediction = (\n        result.outcome