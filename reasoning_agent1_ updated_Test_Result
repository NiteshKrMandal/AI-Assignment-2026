rix [ [TN, FP], [FN, TP] ]:\n[[126, 5], [26, 46]]\n\nClassification report:\n              precision    recall  f1-score   support\n\n       False       0.83      0.96      0.89       131\n        True       0.90      0.64      0.75        72\n\n    accuracy                           0.85       203\n   macro avg       0.87      0.80      0.82       203\nweighted avg       0.85      0.85      0.84       203\n\n\nPredictions saved: /kaggle/working/AI_Assignment_2026/outputs/folio_validation_predictions.csv\n\nSaved metrics: /kaggle/working/AI_Assignment_2026/outputs/folio_z3_metrics.csv\n\nSaved metrics: /kaggle/working/AI_Assignment_2026/outputs/folio_z3_metrics.csv\n\nParser recovery counts: {'repaired': 118, 'unrepaired': 116}\nSuccessfully repaired formulas: 118\n\n==============================================================================\nFOLIO TRAIN — PARSER-CLEAN CLASSIFICATION METRICS\n==============================================================================\nTotal examples:       1001\nSuccessfully parsed:  896\nParser failures:      105\nParser coverage:      89.51%\nClean accuracy:       0.8315\nClean precision:      0.9036\nClean recall:         0.6392\nClean F1-score:       0.7488\n\n==============================================================================\nFOLIO VALIDATION — PARSER-CLEAN CLASSIFICATION METRICS\n==============================================================================\nTotal examples:       203\nSuccessfully parsed:  192\nParser failures:      11\nParser coverage:      94.58%\nClean accuracy:       0.8594\nClean precision:      0.9020\nClean recall:         0.6765\nClean F1-score:       0.7731\n\nParser-clean metrics saved: /kaggle/working/AI_Assignment_2026/outputs/folio_parser_clean_metrics.csv\n\nFinal parser recovery counts: {'repaired': 118, 'unrepaired': 116}\nSuccessfully repaired formulas: 118\nUnrepaired parser failures: 116\n\nFOLIO evaluation completed.\nExisting parser failures are retained and reported.\nNo experimental terminal-parenthesis repair was applied.\n\nFOLIO FINAL RESULTS ARE FROZEN.\n","output_type":"stream"}],"execution_count":14},{"cell_type":"code","source":"\n# ============================================================\n# SECTION 19 — PUBLIC EVALUATION + PRIVATE SUBMISSION\n# FINAL FROZEN VERSION\n# ============================================================\n#\n# Responsibilities:\n# 1. Collect existing public evaluation predictions.\n# 2. Generate combined public prediction CSV.\n# 3. Generate detailed prediction and metric reports.\n# 4. Support future private-test inference.\n# 5. Validate private predictions before writing submission.csv.\n#\n# IMPORTANT:\n# - Does not retrain or rerun public benchmark evaluations.\n# - Does not fabricate private-test predictions.\n# - Public submission is only a fallback until private data arrives.\n# - Existing benchmark results remain frozen.\n# ============================================================\n\nfrom pathlib import Path\nimport json\nimport time\nimport pandas as pd\nimport numpy as np\n\nfrom tqdm.auto import tqdm\n\n\n# ============================================================\n# 1. PATH CONFIGURATION\n# ============================================================\n\nPROJECT_DIR = Path(PROJECT_DIR)\nOUTPUT_DIR = Path(OUTPUT_DIR)\n\nOUTPUT_DIR.mkdir(\n    parents=True,\n    exist_ok=True\n)\n\nSUBMISSION_DIR = Path(\n    \"/kaggle/working/submission\"\n)\n\nSUBMISSION_DIR.mkdir(\n    parents=True,\n    exist_ok=True\n)\n\nSUBMISSION_PATH = (\n    SUBMISSION_DIR / \"submission.csv\"\n)\n\n# Leave None until the instructor releases the private test file.\n# Supported formats: CSV, JSONL, JSON.\n\nPRIVATE_TEST_PATH = None\n\n# Example:\n# PRIVATE_TEST_PATH = \"/kaggle/input/competition/test.csv\"\n\n\n# ============================================================\n# 2. PRIVATE TEST LOADER\n# ============================================================\n\ndef load_private_test(path):\n\n    path = Path(path)\n\n    if not path.is_file():\n\n        raise FileNotFoundError(\n            f\"Private test file not found: {path}\"\n        )\n\n    suffix = path.suffix.lower()\n\n    if suffix == \".csv\":\n\n        return pd.read_csv(path)\n\n    if suffix in {\".jsonl\", \".jl\"}:\n\n        return pd.read_json(\n            path,\n            lines=True\n        )\n\n    if suffix == \".json\":\n\n        return pd.read_json(path)\n\n    raise ValueError(\n        \"Supported formats are .csv, .jsonl, and .json.\"\n    )\n\n\n# ============================================================\n# 3. SAFE BOOLEAN NORMALIZATION\n# ============================================================\n\ndef _as_bool_prediction(value):\n\n    if isinstance(value, dict):\n\n        value = value.get(\"prediction\")\n\n    if value is None:\n\n        raise ValueError(\n            \"Reasoning engine returned no prediction.\"\n        )\n\n    if isinstance(value, (bool, np.bool_)):\n\n        return bool(value)\n\n    if isinstance(value, (int, np.integer)):\n\n        if value in (0, 1):\n\n            return bool(value)\n\n    if isinstance(value, (float, np.floating)):\n\n        if value in (0.0, 1.0):\n\n            return bool(value)\n\n    if isinstance(value, str):\n\n        normalized = value.strip().lower()\n\n        if normalized in {\n            \"true\", \"1\", \"yes\", \"entailed\"\n        }:\n\n            return True\n\n        if normalized in {\n            \"false\", \"0\", \"no\", \"not_entailed\",\n            \"not entailed\", \"uncertain\"\n        }:\n\n            return False\n\n    raise ValueError(\n        f\"Cannot safely interpret prediction: {value!r}\"\n    )\n\n\n# ============================================================\n# 4. PRIVATE RECORD PREDICTION DISPATCHER\n# ============================================================\n\ndef predict_private_record(row):\n\n    \"\"\"Dispatch one record to its corresponding classical reasoner.\"\"\"\n\n    record = (\n        row.to_dict()\n        if isinstance(row, pd.Series)\n        else dict(row)\n    )\n\n    task = str(\n        record.get(\"task\", \"\")\n    ).strip().lower()\n\n    # Infer task from input columns when task is not provided.\n    if not task:\n\n        if {\n            \"context\",\n            \"statement\"\n        }.issubset(record):\n\n            task = \"ruletaker\"\n\n        elif {\n            \"given_info\",\n            \"question\"\n        }.issubset(record):\n\n            task = \"counterbench\"\n\n        elif {\n            \"premises-FOL\",\n            \"conclusion-FOL\"\n        }.issubset(record):\n\n            task = \"folio\"\n\n        else:\n\n            raise ValueError(\n                \"Cannot infer task. Expected one of these field pairs: \"\n                \"(context, statement), \"\n                \"(given_info, question), \"\n                \"(premises-FOL, conclusion-FOL).\"\n            )\n\n    # --------------------------------------------------------\n    # RuleTaker\n    # --------------------------------------------------------\n\n    if task in {\n        \"ruletaker\",\n        \"rule_taker\",\n        \"rule-taker\"\n    }:\n\n        result = predict_ruletaker(\n            record[\"context\"],\n            record[\"statement\"],\n            method=\"forward\"\n        )\n\n        return _as_bool_prediction(result)\n\n    # --------------------------------------------------------\n    # CounterBench\n    # --------------------------------------------------------\n\n    if task in {\n        \"counterbench\",\n        \"counterbench_backdoor\",\n        \"backdoor\"\n    }:\n\n        result = cb21_answer(\n            record[\"given_info\"],\n            record[\"question\"]\n        )\n\n        return _as_bool_prediction(result)\n\n    # --------------------------------------------------------\n    # FOLIO\n    # --------------------------------------------------------\n\n    if task in {\n        \"folio\",\n        \"folio_z3\"\n    }:\n\n        prover = FOLIOProver(\n            timeout_ms=8000,\n            fuzzy_alignment=True\n        )\n\n        predicted, solver_status = (\n            prover.prove_folio_detailed(\n                record[\"premises-FOL\"],\n                record[\"conclusion-FOL\"]\n            )\n        )\n\n        return bool(predicted)\n\n    raise ValueError(\n        f\"Unsupported task value: {task!r}\"\n    )\n\n\n# ============================================================\n# 5. PRIVATE SUBMISSION GENERATOR\n# ============================================================\n\ndef create_submission(\n    test_df,\n    output_path,\n    source_name=\"private\"\n):\n\n    \"\"\"Run inference and create the two-column submission CSV.\"\"\"\n\n    if test_df.empty:\n\n        raise ValueError(\n            \"Test dataset is empty.\"\n        )\n\n    # Identify ID column.\n    id_candidates = [\n        \"id\",\n        \"example_id\",\n        \"question_id\"\n    ]\n\n    id_col = next(\n        (\n            column\n            for column in id_candidates\n            if column in test_df.columns\n        ),\n        None\n    )\n\n    if id_col is None:\n\n        raise ValueError(\n            \"Test file must contain an ID column named one of: \"\n            + \", \".join(id_candidates)\n        )\n\n    if (\n        test_df[id_col].isna().any()\n        or test_df[id_col].duplicated().any()\n    ):\n\n        raise ValueError(\n            \"Test file contains missing or duplicate IDs.\"\n        )\n\n    # Validate required input fields.\n    for index, row in test_df.iterrows():\n\n        record = row.to_dict()\n\n        task = str(\n            record.get(\"task\", \"\")\n        ).strip().lower()\n\n        if not task:\n\n            if {\n                \"context\",\n                \"statement\"\n            }.issubset(record):\n\n                task = \"ruletaker\"\n\n            elif 