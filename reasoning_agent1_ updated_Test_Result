mark predictions were reused.\n========================================================================================\n","output_type":"stream"}],"execution_count":16},{"cell_type":"markdown","source":"# ============================================================\n# SECTION 19 — OPTIONAL PRIVATE-TEST INFERENCE + SUBMISSION.CSV\n# ============================================================\n\nfrom pathlib import Path\nimport json\nimport pandas as pd\nimport time\n\n# Set this to the provided private test file path in Kaggle.\n# Supported input formats: CSV, JSONL, JSON.\n# Do NOT point this at a public train/validation file.\nPRIVATE_TEST_PATH = None  # Example: \"/kaggle/input/<competition-folder>/test.csv\"\n\nSUBMISSION_DIR = Path(\"/kaggle/working/submission\")\nSUBMISSION_DIR.mkdir(parents=True, exist_ok=True)\n\ndef load_private_test(path):\n    path = Path(path)\n    if not path.is_file():\n        raise FileNotFoundError(f\"Private test file not found: {path}\")\n    if path.suffix.lower() == \".csv\":\n        return pd.read_csv(path)\n    if path.suffix.lower() in {\".jsonl\", \".jl\"}:\n        return pd.read_json(path, lines=True)\n    if path.suffix.lower() == \".json\":\n        return pd.read_json(path)\n    raise ValueError(\"Use a .csv, .jsonl, or .json private test file.\")\n\ndef _as_bool_prediction(value):\n    if isinstance(value, dict):\n        value = value.get(\"prediction\")\n    if value is None:\n        raise ValueError(\"Reasoning engine returned no prediction.\")\n    return bool(value)\n\ndef predict_private_record(row):\n    \"\"\"\n    Dispatch a row to the classical reasoning engine based on its fields.\n    Accepted schemas:\n      RuleTaker: context, statement\n      CounterBench: given_info, question\n      FOLIO: premises-FOL, conclusion-FOL\n    An optional task column can be 'ruletaker', 'counterbench', or 'folio'.\n    \"\"\"\n    record = row.to_dict() if isinstance(row, pd.Series) else dict(row)\n    task = str(record.get(\"task\", \"\")).strip().lower()\n\n    if not task:\n        if {\"context\", \"statement\"}.issubset(record):\n            task = \"ruletaker\"\n        elif {\"given_info\", \"question\"}.issubset(record):\n            task = \"counterbench\"\n        elif {\"premises-FOL\", \"conclusion-FOL\"}.issubset(record):\n            task = \"folio\"\n        else:\n            raise ValueError(\n                \"Cannot infer task. Provide task or one of these field pairs: \"\n                \"(context, statement), (given_info, question), \"\n                \"(premises-FOL, conclusion-FOL).\"\n            )\n\n    if task in {\"ruletaker\", \"rule_taker\", \"rule-taker\"}:\n        result = predict_ruletaker(\n            record[\"context\"], record[\"statement\"], method=\"forward\"\n        )\n        return _as_bool_prediction(result)\n\n    if task in {\"counterbench\", \"counterbench_backdoor\", \"backdoor\"}:\n        # This uses the separate Backdoor V2.1 causal counterfactual engine.\n        # The frozen Alpha PBCI V1.0 result and original V2 baseline are not altered.\n        return _as_bool_prediction(\n            cb21_answer(record[\"given_info\"], record[\"question\"])\n        )\n\n    if task in {\"folio\", \"folio_z3\"}:\n        prover = FOLIOProver(timeout_ms=8000, fuzzy_alignment=True)\n        predicted, solver_status = prover.prove_folio_detailed(\n            record[\"premises-FOL\"], record[\"conclusion-FOL\"]\n        )\n        return bool(predicted)\n\n    raise ValueError(f\"Unsupported task value: {task!r}\")\n\ndef create_submission(test_df, output_path):\n    if test_df.empty:\n        raise ValueError(\"Private test dataset is empty.\")\n\n    id_candidates = [\"id\", \"example_id\", \"question_id\"]\n    id_col = next((c for c in id_candidates if c in test_df.columns), None)\n    if id_col is None:\n        raise ValueError(\n            \"Private test file must contain an ID column named one of: \"\n            + \", \".join(id_candidates)\n        )\n    if test_df[id_col].isna().any():\n        raise ValueError(\"Private test file contains missing IDs.\")\n    if test_df[id_col].duplicated().any():\n        raise ValueError(\"Private test file contains duplicate IDs.\")\n\n    start = time.perf_counter()\n    predictions = []\n    errors = []\n    for index, row in tqdm(test_df.iterrows(), total=len(test_df), desc=\"Private inference\"):\n        try:\n            predictions.append(predict_private_record(row))\n        except Exception as exc:\n            errors.append({\n                \"row_index\": int(index),\n                \"id\": row[id_col],\n                \"error\": f\"{type(exc).__name__}: {exc}\",\n            })\n            predictions.append(None)\n\n    elapsed = time.perf_counter() - start\n    if errors:\n        error_path = Path(output_path).with_name(\"submission_errors.csv\")\n        pd.DataFrame(errors).to_csv(error_path, index=False)\n        raise RuntimeError(\n            f\"{len(errors)} rows could not be predicted. No submission was written. \"\n            f\"Inspect {error_path}; fix parser/schema issues and rerun.\"\n        )\n\n    submission = pd.DataFrame({\n        \"id\": test_df[id_col].values,\n        \"predicted_label\": [\"True\" if p else \"False\" for p in predictions],\n    })\n    if len(submission) != len(test_df):\n        raise AssertionError(\"Submission row count does not match private test input.\")\n    if submission[\"id\"].duplicated().any() or submission.isna().any().any():\n        raise AssertionError(\"Submission contains duplicate IDs or missing values.\")\n    if not set(submission[\"predicted_label\"].unique()).issubset({\"True\", \"False\"}):\n        raise AssertionError(\"Submission contains an invalid label.\")\n\n    output_path = Path(output_path)\n    output_path.parent.mkdir(parents=True, exist_ok=True)\n    submission.to_csv(output_path, index=False)\n\n    print(\"\\nPRIVATE-TEST INFERENCE SUMMARY\")\n    print(\"Rows:\", len(submission))\n    print(f\"Total inference time: {elapsed:.6f} seconds\")\n    print(f\"Average per example: {elapsed / len(submission):.8f} seconds\")\n    print(\"Saved:\", output_path)\n    print(\"Columns:\", submission.columns.tolist())\n    display(submission.head())\n    return submission\n\nif PRIVATE_TEST_PATH:\n    private_test_df = load_private_test(PRIVATE_TEST_PATH)\n    submission_df = create_submission(\n        private_test_df,\n        SUBMISSION_DIR / \"submission.csv\"\n    )\nelse:\n    print(\n        \"Private test file not configured. No submission.csv has been fabricated.\\n\"\n        \"After the instructor supplies the private test file, set PRIVATE_TEST_PATH \"\n        \"above and rerun this cell. Expected output: /kaggle/working/submission/submission.csv\"\n    )\n\n# Final public-experiment output audit (does not overwrite any benchmark file).\nexpected_outputs = [\n    \"counterbench_backdoor_v21_metrics.json\",\n    \"counterbench_backdoor_v21_predictions.csv\",\n    \"folio_z3_metrics.csv\",\n]\nprint(\"\\nPUBLIC EXPERIMENT OUTPUT CHECK\")\nfor name in expected_outputs:\n    path = OUTPUT_DIR / name\n    print(f\"{name:48s} | {'FOUND' if path.exists() else 'NOT YET CREATED'}\")","metadata":{"execution":{"iopub.status.busy":"2026-11-11T18:41:49.855599Z","iopub.execute_input":"2026-11-11T18:41:49.856054Z","iopub.status.idle":"2026-11-11T18:41:49.887375Z","shell.execute_reply.started":"2026-11-11T18:41:49.856026Z","shell.execute_reply":"2026-11-11T18:41:49.885957Z"}}},{"cell_type":"code","source":"print(\"TEst\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T12:40:51.514264Z","iopub.execute_input":"2026-11-17T12:40:51.514641Z","iopub.status.idle":"2026-11-17T12:40:51.520421Z","shell.execute_reply.started":"2026-11-17T12:40:51.514617Z","shell.execute_reply":"2026-11-17T12:40:51.519466Z"}},"outputs":[{"name":"stdout","text":"TEst\n","output_type":"stream"}],"execution_count":17},{"cell_type":"code"