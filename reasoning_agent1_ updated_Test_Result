----------------------------\n\n@dataclass(frozen=True)\nclass Atom:\n    \"\"\"\n    An atomic proposition represented by a predicate and arguments.\n\n    Examples:\n        Atom(\"rains\", ())\n        Atom(\"likes\", (\"john\", \"mary\"))\n    \"\"\"\n    predicate: str\n    arguments: tuple = ()\n\n    def __post_init__(self):\n        object.__setattr__(\n            self,\n            \"predicate\",\n            normalize_text(self.predicate)\n        )\n        object.__setattr__(\n            self,\n            \"arguments\",\n            tuple(normalize_text(arg) for arg in self.arguments)\n        )\n\n    def __str__(self):\n        if not self.arguments:\n            return self.predicate\n\n        return f\"{self.predicate}({', '.join(self.arguments)})\"\n\n\n# ------------------------------------------------------------\n# 3. Represent positive and negative literals\n# ------------------------------------------------------------\n\n@dataclass(frozen=True)\nclass Literal:\n    atom: Atom\n    negated: bool = False\n\n    def __str__(self):\n        return f\"not {self.atom}\" if self.negated else str(self.atom)\n\n\n# ------------------------------------------------------------\n# 4. Represent an implication rule\n# ------------------------------------------------------------\n\n@dataclass(frozen=True)\nclass LogicalRule:\n    \"\"\"\n    A Horn-style implication:\n\n        antecedents -> consequent\n\n    Example:\n        [rainy, cold] -> wears_coat\n    \"\"\"\n    antecedents: tuple\n    consequent: Literal\n    rule_id: Optional[str] = None\n\n    def __post_init__(self):\n        object.__setattr__(\n            self,\n            \"antecedents\",\n            tuple(self.antecedents)\n        )\n\n        if not all(\n            isinstance(item, Literal)\n            for item in self.antecedents\n        ):\n            raise TypeError(\"All antecedents must be Literal objects.\")\n\n        if not isinstance(self.consequent, Literal):\n            raise TypeError(\"Consequent must be a Literal object.\")\n\n    def __str__(self):\n        left = \" AND \".join(str(x) for x in self.antecedents)\n        return f\"{left} -> {self.consequent}\"\n\n\n# ------------------------------------------------------------\n# 5. Represent a knowledge base\n# ------------------------------------------------------------\n\n@dataclass\nclass KnowledgeBase:\n    facts: set = field(default_factory=set)\n    rules: list = field(default_factory=list)\n\n    def add_fact(self, literal: Literal):\n        if not isinstance(literal, Literal):\n            raise TypeError(\"Knowledge-base facts must be Literal objects.\")\n        self.facts.add(literal)\n\n    def add_rule(self, rule: LogicalRule):\n        if not isinstance(rule, LogicalRule):\n            raise TypeError(\"Expected a LogicalRule object.\")\n        self.rules.append(rule)\n\n    def contains(self, literal: Literal) -> bool:\n        return literal in self.facts\n\n    def summary(self):\n        return {\n            \"number_of_facts\": len(self.facts),\n            \"number_of_rules\": len(self.rules),\n            \"facts\": sorted(str(fact) for fact in self.facts),\n            \"rules\": [str(rule) for rule in self.rules]\n        }\n\n\n# ------------------------------------------------------------\n# 6. Helper for creating simple propositional literals\n# ------------------------------------------------------------\n\ndef make_literal(text: str) -> Literal:\n    \"\"\"\n    Convert a simple text proposition into a Literal.\n\n    This helper is intended for normalized propositional atoms.\n    More complex first-order formulas will be handled by the\n    dedicated FOLIO parser.\n    \"\"\"\n    text = normalize_text(text)\n\n    negated = False\n\n    if text.startswith(\"not \"):\n        negated = True\n        text = text[4:].strip()\n    elif text.startswith(\"not(\") and text.endswith(\")\"):\n        negated = True\n        text = text[4:-1].strip()\n\n    if not text:\n        raise ValueError(\"Cannot create a literal from empty text.\")\n\n    return Literal(\n        atom=Atom(predicate=text),\n        negated=negated\n    )\n\n\n# ------------------------------------------------------------\n# 7. Test the representation\n# ------------------------------------------------------------\n\ntest_kb = KnowledgeBase()\n\nfact_1 = make_literal(\"The river is fast.\")\nfact_2 = make_literal(\"The wall dances gracefully.\")\n\nrule_1 = LogicalRule(\n    antecedents=(fact_1,),\n    consequent=make_literal(\"The river becomes famous.\"),\n    rule_id=\"R1\"\n)\n\nrule_2 = LogicalRule(\n    antecedents=(\n        make_literal(\"The river becomes famous\"),\n        fact_2\n    ),\n    consequent=make_literal(\"The river is interesting\"),\n    rule_id=\"R2\"\n)\n\ntest_kb.add_fact(fact_1)\ntest_kb.add_fact(fact_2)\ntest_kb.add_rule(rule_1)\ntest_kb.add_rule(rule_2)\n\nprint(\"=\" * 65)\nprint(\"SHARED LOGICAL REPRESENTATION — TEST\")\nprint(\"=\" * 65)\n\nprint(\"\\nKnowledge-base summary:\")\nfor key, value in test_kb.summary().items():\n    print(f\"{key}:\")\n    print(value)\n\nprint(\"\\nLiteral test:\")\nprint(\"Positive:\", make_literal(\"The river is fast\"))\nprint(\"Negative:\", make_literal(\"not The river is fast\"))\n\nassert len(test_kb.facts) == 2\nassert len(test_kb.rules) == 2\nassert test_kb.contains(fact_1)\n\nprint(\"\\nAll representation tests passed.\")\nprint(\"Section 4 completed successfully.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T12:40:31.66798Z","iopub.execute_input":"2026-11-17T12:40:31.668267Z","iopub.status.idle":"2026-11-17T12:40:31.696807Z","shell.execute_reply.started":"2026-11-17T12:40:31.668244Z","shell.execute_reply":"2026-11-17T12:40:31.695694Z"}},"outputs":[{"name":"stdout","text":"=================================================================\nSHARED LOGICAL REPRESENTATION — TEST\n=======================================================