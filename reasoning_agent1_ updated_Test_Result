n\",\n        re.compile(\n            r\"^when\\s+(.+?),\\s*we can conclude\\s+(.+)$\",\n            re.IGNORECASE\n        )\n    )\n]\n\n\ndef parse_ruletaker_rule(line, rule_id=None):\n    \"\"\"\n    Parse a RuleTaker implication into a LogicalRule.\n\n    Returns:\n        (LogicalRule, pattern_name) if parsing succeeds\n        (None, None) otherwise\n    \"\"\"\n\n    sentence = clean_ruletaker_sentence(line)\n\n    for pattern_name, pattern in RULE_PATTERNS:\n        match = pattern.match(sentence)\n\n        if match:\n            antecedent_text = clean_ruletaker_sentence(match.group(1))\n            consequent_text = clean_ruletaker_sentence(match.group(2))\n\n            if not antecedent_text or not consequent_text:\n                return None, None\n\n            rule = LogicalRule(\n                antecedents=(make_literal(antecedent_text),),\n                consequent=make_literal(consequent_text),\n                rule_id=rule_id\n            )\n\n            return rule, pattern_name\n\n    return None, None\n\n\n# ------------------------------------------------------------\n# 3. Parse facts and rules from one context\n# ------------------------------------------------------------\n\ndef parse_ruletaker_context(context):\n    \"\"\"\n    Parse a RuleTaker context into a KnowledgeBase.\n\n    Expected format:\n        Facts:\n        fact 1.\n        fact 2.\n        Rules:\n        If condition, then conclusion.\n    \"\"\"\n\n    kb = KnowledgeBase()\n\n    current_section = None\n    fact_count = 0\n    rule_count = 0\n\n    parsed_facts = []\n    parsed_rules = []\n    unparsed_lines = []\n    pattern_counts = Counter()\n\n    lines = str(context).splitlines()\n\n    for line_number, raw_line in enumerate(lines, start=1):\n        line = raw_line.strip()\n\n        if not line:\n            continue\n\n        section_header = line.lower().rstrip(\":\")\n\n        if section_header == \"facts\":\n            current_section = \"facts\"\n            continue\n\n        if section_header == \"rules\":\n            current_section = \"rules\"\n            continue\n\n        if current_section == \"facts\":\n            fact_text = clean_ruletaker_sentence(line)\n\n            if fact_text:\n                literal = make_literal(fact_text)\n                kb.add_fact(literal)\n                parsed_facts.append(fact_text)\n                fact_count += 1\n            else:\n                unparsed_lines.append({\n                    \"line_number\": line_number,\n                    \"text\": raw_line,\n                    \"section\": current_section\n                })\n\n        elif current_section == \"rules\":\n            rule_id = f\"R{rule_count + 1}\"\n\n            rule, pattern_name = parse_ruletaker_rule(\n                line,\n                rule_id=rule_id\n            )\n\n            if rule is not None:\n                kb.add_rule(rule)\n                parsed_rules.append(str(rule))\n                pattern_counts[pattern_name] += 1\n                rule_count += 1\n            else:\n                unparsed_lines.append({\n                    \"line_number\": line_number,\n                    \"text\": raw_line,\n                    \"section\": current_section\n                })\n\n        else:\n            unparsed_lines.append({\n                \"line_number\": line_number,\n                \"text\": raw_line,\n                \"section\": \"unknown\"\n            })\n\n    result = {\n        \"knowledge_base\": kb,\n        \"fact_count\": fact_count,\n        \"rule_count\": rule_count,\n        \"parsed_facts\": parsed_facts,\n        \"parsed_rules\": parsed_rules,\n        \"pattern_counts\": dict(pattern_counts),\n        \"unparsed_lines\": unparsed_lines\n    }\n\n    return result\n\n\n# ------------------------------------------------------------\n# 4. Test on the actual RuleTaker training example\n# ------------------------------------------------------------\n\nsample_context = RULETAKER_DF[\"train\"].iloc[0][\"context\"]\n\nsample_result = parse_ruletaker_context(sample_context)\nsample_kb = sample_result[\"knowledge_base\"]\n\nprint(\"=\" * 70)\nprint(\"RULETAKER PARSER — SAMPLE TEST\")\nprint(\"=\" * 70)\n\nprint(\"\\nExtracted facts:\")\nfor fact in sorted(sample_kb.facts, key=str):\n    print(\" -\", fact)\n\nprint(\"\\nExtracted rules:\")\nfor rule in sample_kb.rules:\n    print(\" -\", rule)\n\nprint(\"\\nParser statistics:\")\nprint(\"Facts:\", sample_result[\"fact_count\"])\nprint(\"Rules:\", sample_result[\"rule_count\"])\nprint(\"Rule patterns:\", sample_result[\"pattern_counts\"])\nprint(\"Unparsed lines:\", len(sample_result[\"unparsed_lines\"]))\n\nif sample_result[\"unparsed_lines\"]:\n    print(\"\\nUnparsed line examples:\")\n    for item in sample_result[\"unparsed_lines\"][:5]:\n        print(item)\n\n\n# ------------------------------------------------------------\n# 5. Measure parser coverage across all RuleTaker splits\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 70)\nprint(\"RULETAKER PARSER COVERAGE\")\nprint(\"=\" * 70)\n\nRULETAKER_PARSE_STATS = {}\n\nfor split_name, df in RULETAKER_DF.items():\n\n    total_facts = 0\n    total_rules = 0\n    total_unparsed = 0\n    total_lines = 0\n    pattern_totals = Counter()\n\n    for context in df[\"context\"]:\n        result = parse_ruletaker_context(context)\n\n        total_facts += result[\"fact_count\"]\n        total_rules += result[\"rule_count\"]\n        total_unparsed += len(result[\"unparsed_lines\"])\n        total_lines += (\n            result[\"fact_count\"]\n            + result[\"rule_count\"]\n            + len(result[\"unparsed_lines\"])\n        )\n\n        pattern_totals.update(result[\"pattern_counts\"])\n\n    coverage = (\n        (total_facts + total_rules) / total_lines\n        if total_lines else 0.0\n    )\n\n    RULETAKER_PARSE_STATS[split_name] = {\n        \"examples\": len(