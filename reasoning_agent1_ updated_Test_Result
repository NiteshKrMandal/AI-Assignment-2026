libc2.39\nProject: /kaggle/working/AI_Assignment_2026\nHugging Face token available: True\nRuleTaker: jise/ruletaker\nFOLIO: tasksource/folio\nCounterBench: CounterBench/CounterBench\n","output_type":"stream"}],"execution_count":1},{"cell_type":"code","source":"# ============================================================\n# SECTION 2 — DATA DOWNLOADING FROM HUGGING FACE AND NORMALIZATION\n# ============================================================\n\nfrom datasets import load_dataset\nfrom huggingface_hub import hf_hub_download, list_repo_files\nimport json\nimport pandas as pd\n\ndef _to_frame(dataset_split):\n    \"\"\"Convert a Hugging Face Dataset split to a pandas DataFrame.\"\"\"\n    return dataset_split.to_pandas()\n\ndef _read_json_records(path):\n    \"\"\"Read a JSON list/dict or JSONL file downloaded from the Hub.\"\"\"\n    with open(path, \"r\", encoding=\"utf-8\") as f:\n        raw = f.read().strip()\n    if not raw:\n        raise ValueError(f\"Downloaded dataset file is empty: {path}\")\n    try:\n        obj = json.loads(raw)\n    except json.JSONDecodeError:\n        obj = [json.loads(line) for line in raw.splitlines() if line.strip()]\n    if isinstance(obj, list):\n        return pd.DataFrame(obj)\n    if isinstance(obj, dict):\n        # CounterBench source files are expected to be list-like; handle\n        # common dictionary wrappers without silently flattening scalars.\n        for key in (\"data\", \"records\", \"questions\", \"models\"):\n            if key in obj and isinstance(obj[key], list):\n                return pd.DataFrame(obj[key])\n        return pd.DataFrame(list(obj.values()))\n    raise TypeError(f\"Unsupported JSON structure in {path}: {type(obj).__name__}\")\n\nprint(\"=\" * 72)\nprint(\"[1/3] Downloading RuleTaker from Hugging Face...\")\nruletaker_data = load_dataset(RULETAKER_REPO, token=HF_TOKEN)\nRULETAKER_DF = {}\nfor split_name, split in ruletaker_data.items():\n    frame = _to_frame(split)\n    for col in [\"context\", \"statement\", \"reasoning\", \"flag\"]:\n        if col in frame.columns:\n            frame[col] = frame[col].astype(str).str.strip()\n    if \"flag\" in frame.columns:\n        frame[\"flag\"] = frame[\"flag\"].astype(str).str.strip().str.capitalize()\n    RULETAKER_DF[split_name] = frame\n    frame.to_json(\n        NORMALIZED_DIR / f\"ruletaker_{split_name}.jsonl\",\n        orient=\"records\", lines=True, force_ascii=False\n    )\n    print(f\"RuleTaker/{split_name}: {len(frame):,} rows\")\n\nprint(\"\\n[2/3] Downloading FOLIO from Hugging Face...\")\nfolio_data = load_dataset(FOLIO_REPO, token=HF_TOKEN)\nFOLIO_DF = {}\nfor split_name, split in folio_data.items():\n    frame = _to_frame(split)\n    for col in [\"premises\", \"premises-FOL\", \"conclusion\", \"conclusion-FOL\", \"label\"]:\n        if col in frame.columns:\n            frame[col] = frame[col].astype(str).str.strip()\n    FOLIO_DF[split_name] = frame\n    frame.to_json(\n        NORMALIZED_DIR / f\"folio_{split_name}.jsonl\",\n        orient=\"records\", lines=True, force_ascii=False\n    )\n    print(f\"FOLIO/{split_name}: {len(frame):,} rows\")\n\nprint(\"\\n[3/3] Downloading CounterBench JSON files from Hugging Face...\")\ncounterbench_files = [\n    \"data_balanced_alpha_V1.json\",\n    \"data_balanced_backdoor_V2.json\",\n    \"meta_model_alpha_V1.json\",\n    \"meta_model_backdoor_V2.json\",\n]\nrepo_files = set(list_repo_files(\n    COUNTERBENCH_REPO, repo_type=\"dataset\", token=HF_TOKEN\n))\nmissing_repo_files = [name for name in counterbench_files if name not in repo_files]\nif missing_repo_files:\n    raise FileNotFoundError(\n        \"CounterBench repository is missing expected files: \"\n        + \", \".join(missing_repo_files)\n    )\n\ncounterbench_paths = {}\nfor filename in counterbench_files:\n    counterbench_paths[filename] = hf_hub_download(\n        repo_id=COUNTERBENCH_REPO,\n        filename=filename,\n        repo_type=\"dataset\",\n        token=HF_TOKEN,\n        cache_dir=str(CACHE_DIR),\n    )\n    print(\"Downloaded:\", filename)\n\nalpha_questions = _read_json_records(counterbench_paths[\"data_balanced_alpha_V1.json\"])\nbackdoor_questions = _read_json_records(counterbench_paths[\"data_balanced_backdoor_V2.json\"])\nalpha_metadata = _read_json_records(counterbench_paths[\"meta_model_alpha_V1.json\"])\nbackdoor_metadata = _read_json_records(counterbench_paths[\"meta_model_backdoor_V2.json\"])\n\nrequired_q = {\"question\", \"given_info\", \"answer\", \"type\", \"question_id\", \"meta\"}\nrequired_m = {\"model_id\", \"background\", \"variable_mapping\", \"nonsense\"}\nfor name, frame in {\n    \"CounterBench Alpha questions\": alpha_questions,\n    \"CounterBench Backdoor questions\": backdoor_questions,\n}.items():\n    missing = required_q - set(frame.columns)\n    if missing:\n        raise ValueError(f\"{name} missing required columns: {sorted(missing)}\")\nfor name, frame in {\n    \"CounterBench Alpha metadata\": alpha_metadata,\n    \"CounterBench Backdoor metadata\": backdoor_metadata,\n}.items():\n    missing = required_m - set(frame.columns)\n    if missing:\n        raise ValueError(f\"{name} missing required columns: {sorted(missing)}\")\n\ndef _extract_cb_metadata(frame):\n    frame = frame.copy()\n    frame[\"graph_id\"] = frame[\"meta\"].apply(\n        lambda x: x.get(\"graph_id\") if isinstance(x, dict) else None\n    )\n    frame[\"model_id\"] = frame[\"meta\"].apply(\n        lambda x: x.get(\"model_id\") if isinstance(x, dict) else None\n    )\n    frame[\"model_id\"] = pd.to_numeric(frame[\"model_id\"], errors=\"coerce\").astype(\"Int64\")\n    frame[\"question_id\"] = frame[\"question_id\"].astype(str)\n    frame[\"answer\"] = frame[\"answer\"].astype(str).str.lower().str.strip()\n    return frame\n\nalpha_questions = _extract_cb_metadata(alpha_questions)\nbackdoor_questions = _extract_cb_metadata(backdoor_questions)\nalpha_metadata[\"model_id\"] = pd.to_numeric(alpha_metadata[\"model_id\"], errors=\"raise\").astype(\"Int64\")\nbackdoor_metadata[\"model_id\"] = pd.to_numeric(backdoor_metadata[\"model_id\"], errors=\"raise\").astype(\"Int64\")\n\nCOUNTERBENCH_ALPHA = alpha_questions.merge(\n    alpha_metadata, on=\"model_id\", how=\"left\",\n    validate=\"many_to_one\", suffixes=(\"\", \"_model\"), indicator=True\n)\nCOUNTERBENCH_BACKDOOR = backdoor_questions.merge(\n    backdoor_metadata, on=\"model_id\", how=\"left\",\n    validate=\"many_to_one\", suffixes=(\"\", \"_model\"), indicator=True\n)\nfor dataset_name, frame in [\n    (\"Alpha\", COUNTERBENCH_ALPHA), (\"Backdoor\", COUNTERBENCH_BACKDOOR)\n]:\n    unmatched = int((frame[\"_merge\"] != \"both\").sum())\n    if unmatched:\n        raise ValueError(f\"CounterBench {dataset_name}: {unmatched} rows lack model metadata.\")\n    frame.drop(columns=[\"_merge\"], inplace=True)\n    if not set(frame[\"answer\"].unique()).issubset({\"yes\", \"no\"}):\n        raise ValueError(f\"Unexpected answer labels in CounterBench {dataset_name}.\")\n\nCOUNTERBENCH_ALPHA.to_json(\n    NORMALIZED_DIR / \"counterbench_alpha.jsonl\",\n    orient=\"records\", lines=True, force_ascii=False\n)\nCOUNTERBENCH_BACKDOOR.to_json(\n    NORMALIZED_DIR / \"counterbench_backdoor.jsonl\",\n    orient=\"records\", lines=True, force_ascii=False\n)\n\n# Preserve dataset provenance and exact Hub identifiers.\ndataset_metadata = {\n    \"source\": \"Hugging Face Hub\",\n    \"repositories\": {\n        \"ruletaker\": RULETAKER_REPO,\n        \"folio\": FOLIO_REPO,\n        \"counterbench\": COUNTERBENCH_REPO,\n    },\n    \"ruleTaker_splits\": {\n        k: {\"rows\": len(v), \"columns\": list(v.columns)}\n        for k, v in RULETAKER_DF.items()\n    },\n    \"folio_splits\": {\n        k: {\"rows\": len(v), \"columns\": list(v.columns)}\n        for k, v in FOLIO_DF.items()\n    },\n    \"counterbench\": {\n        \"alpha_rows\": len(COUNTERBENCH_ALPHA),\n        \"backdoor_rows\": len(COUNTERBENCH_BACKDOOR),\n        \"source_files\": counterbench_files,\n    },\n}\nwith open(DATA_DIR / \"dataset_metadata.json\", \"w\", encoding=\"utf-8\") as f:\n    json.dump(dataset_metadata, f, indent=2)\n\nprint(\"\\n\" + \"=\" * 72)\nprint(\"HUGGING FACE DOWNLOAD AND NORMALIZATION COMPLETED\")\nprint(\"RuleTaker splits:\", {k: len(v) for k, v in RULETAKER_DF.items()})\nprint(\"FOLIO splits:\", {k: len(v) for k, v in FOLIO_DF.items()})\nprint(\"CounterBench Alpha:\", len(COUNTERBENCH_ALPHA))\nprint(\"CounterBench Backdoor:\", len(COUNTERBENCH_BACKDOOR))\nprint(\"Normalized data directory:\", NORMALIZED_DIR)\nprint(\"Metadata:\", DATA_DIR / \"dataset_metadata.json\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T12:40:22.708513Z","iopub.execute_input":"2026-11-17T12:40:22.709139Z","iopub.status.idle":"2026-11-17T12:40:31.532196Z","shell.execute_reply.started":"2026-11-17T12:40:22.709107Z","shell.execute_reply":"2026-11-17T12:40:31.529704Z"}},"outputs":[{"name":"stdout","text":"========================================================================\n[1/3] Downloading RuleTaker from Hugging Face...\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"README.md:   0%|          | 0.00/955 [00:00<?, ?B/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"ff10c2ecf8d64ac6af7275897728502f"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"data/train-00000-of-00001.parquet: reconstructing file:   0%|          |  0.00B /  242kB            ","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"e1421537bf0444e795aa2fafb8355b75"}},"metadata":{}},{"output_type":"display_data","data":{"text/plain":"data/train-00000-of-00001.parquet: downloading bytes:           |  0.00B            ","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"307b5b74707847b2baa716492130785f"}},"metadata":{}},{"output_type":"display_data","data":{"text/p