---------------\n\ndef identify_logic_format(row):\n    context = str(row[\"context_logic\"]).strip()\n    statement = str(row[\"statement_logic\"]).strip()\n\n    # Causal equations: X = A OR B, Evidence: ..., Y_{X=0} = 1 ?\n    if (\n        re.search(r\"(?m)^\\s*[A-Za-z][A-Za-z0-9_]*\\s*=\\s*.+\", context)\n        and re.search(r\"Evidence\\s*:\", context, re.I)\n        and re.search(r\"\\{.*=.*\\}\", statement)\n    ):\n        return \"causal\"\n\n    # Tuple-style facts and implication rules.\n    if re.search(r'\\(\"[^\"]+\"\\s+\"[^\"]+\"\\s+\"[^\"]+\"\\s+\"[+-]\"\\)', context):\n        return \"tuple_rules\"\n\n    # Otherwise, use the existing FOL parser.\n    return \"folio\"\n\n\nprivate_df[\"logic_type\"] = private_df.apply(\n    identify_logic_format, axis=1\n)\n\nprint(\"\\nLOGIC FORMAT DISTRIBUTION\")\nprint(private_df[\"logic_type\"].value_counts())\n\n\n# ------------------------------------------------------------\n# 3. TUPLE-STYLE RULE REASONER\n# ------------------------------------------------------------\n\ndef extract_tuple_atoms(text):\n    \"\"\"Extract atoms represented as ('subject' 'relation' 'object' '+/-').\"\"\"\n    pattern = r'\\((?:\"[^\"]*\"\\s*){4}\\)'\n    atoms = []\n\n    for match in re.finditer(pattern, str(text)):\n        values = re.findall(r'\"([^\"]*)\"', match.group(0))\n\n        if len(values) == 4:\n            atoms.append(tuple(values))\n\n    return atoms\n\n\ndef tuple_is_variable(value):\n    return value.lower() in {\"someone\", \"something\"}\n\n\ndef tuple_unify(pattern, fact, bindings=None):\n    \"\"\"Unify a rule atom with a known ground fact.\"\"\"\n    bindings = dict(bindings or {})\n\n    if len(pattern) != len(fact):\n        return None\n\n    for p, f in zip(pattern, fact):\n        if tuple_is_variable(p):\n            if p in bindings and bindings[p] != f:\n                return None\n            bindings[p] = f\n        elif p != f:\n            return None\n\n    return bindings\n\n\ndef tuple_substitute(atom, bindings):\n    return tuple(bindings.get(x, x) for x in atom)\n\n\ndef tuple_forward_reason(context_logic, statement_logic):\n    facts = set()\n    rules = []\n\n    # Split the context into facts and implication rules.\n    for line in str(context_logic).splitlines():\n        line = line.strip()\n\n        if not line:\n            continue\n\n        if \"->\" in line:\n            left, right = line.split(\"->\", 1)\n            antecedents = extract_tuple_atoms(left)\n            consequents = extract_tuple_atoms(right)\n\n            if not antecedents or len(consequents) != 1:\n                raise ValueError(f\"Unsupported tuple rule: {line}\")\n\n            rules.append((antecedents, consequents[0]))\n\n        else:\n            extracted = extract_tuple_atoms(line)\n            facts.update(extracted)\n\n    query_atoms = extract_tuple_atoms(statement_logic)\n\n    if len(query_atoms) != 1:\n        raise ValueError(\"Expected exactly one tuple query.\")\n\n    query = query_atoms[0]\n\n    # Forward chaining with variable substitution.\n    changed = True\n    iterations = 0\n    max_iterations = 1000\n\n    while changed and iterations < max_iterations:\n        changed = False\n        iterations += 1\n\n        for antecedents, consequent in rules:\n            substitutions = [{}]\n\n            for premise in antecedents:\n                next_substitutions = []\n\n                for binding in substitutions:\n                    instantiated = tuple_substitute(premise, binding)\n\n                    for fact in list(facts):\n                        # Match against known facts.\n                        result = tuple_unify(instantiated, fact, binding)\n\n                        if result is not None:\n                            next_substitutions.append(result)\n\n                substitutions = next_substitutions\n\n                if not substitutions:\n                    break\n\n            for binding in substitutions:\n                conclusion = tuple_substitute(consequent, binding)\n\n                if conclusion not in facts:\n                    facts.add(conclusion)\n                    changed = True\n\n    if iterations >= max_iterations:\n        raise RuntimeError(\"Tuple reasoning reached iteration limit.\")\n\n    return query in facts\n\n\n# ------------------------------------------------------------\n# 4. CAUSAL COUNTERFACTUAL REASONER\n# ------------------------------------------------------------\n\ndef causal_counterfactual_reason(context_logic, statement_logic):\n    \"\"\"\n    Evaluate Boolean structural equations with:\n      - OR / AND causes\n      - observed evidence\n      - explicit interventions\n      - counterfactual target value\n    \"\"\"\n\n    equations = {}\n    evidence = {}\n    interventions = {}\n\n    # Parse structural equations and evidence.\n    for raw_line in str(context_logic).splitlines():\n        line = raw_line.strip()\n\n        if not line:\n            continue\n\n        if line.lower().startswith(\"evidence:\"):\n            evidence_text = line.split(\":\", 1)[1]\n\n            for item in evidence_text.split(\",\"):\n                match = re.fullmatch(\n                    r\"\\s*([A-Za-z][A-Za-z0-9_]*)\\s*=\\s*([01])\\s*\",\n                    item\n                )\n\n                if match:\n                    evidence[match.group(1)] = bool(int(match.group(2)))\n\n            continue\n\n        match = re.fullmatch(\n            r\"\\s*([A-Za-z][A-Za-z0-9_]*)\\s*=\\s*(.+?)\\s*\",\n            line\n        )\n\n        if not match:\n            raise ValueError(f\"Unsupported causal equation: {line}\")\n\n        variable = match.group(1)\n        expression = match.group(2).strip()\n\n        operator = None\n\n        if re.search(r\"\\s+OR\\s+\", expression, re.I):\n            operator = \"OR\"\n            parents = re.split(r\"\\s+OR\\s+\", expression, flags=re.I)\n\n        elif re.search(r\"\\s+AND\\s+\", expression, re.I):\n            operator = \"AND\"\n            parents = re.split(r\"\\s+AND\\s+\", expression, flags=re.I)\n\n        else:\n            operator = \"OR\"\n            parents = [expression]\n\n        parents = [p.strip() for p in parents]\n\n        if not all(re.fullmatch(r\"[A-Za-z][A-Za-z0-9_]*\", p) for p in parents):\n            raise ValueError(f\"Invalid causal expression: {expression}\")\n\n        equations[variable] = (operator, parents)\n\n    # Parse counterfactual query: Target_{A=0, B=1} = 1 ?\n    query_match = re.fullmatch(\n        r\"\\s*([A-Za-z][A-Za-z0-9_]*)_\\{(.*?)\\}\\s*=\\s*([01])\\s*\\??\\s*\",\n        str(statement_logic).strip()\n    )\n\n    if not query_match:\n        raise ValueError(f\"Unsupported causal query: {statement_logic}\")\n\n    target = query_match.group(1)\n    intervention_text = query_match.group(2)\n    expected_value = bool(int(query_match.group(3)))\n\n    for item in intervention_text.split(\",\"):\n        match = re.fullmatch(\n            r\"\\s*([A-Za-z][A-Za-z0-9_]*)\\s*=\\s*([01])\\s*\",\n            item\n        )\n\n        if not match:\n            raise ValueError(f\"Invalid intervention: {item}\")\n\n        interventions[match.group(1)] = bool(int(match.group(2)))\n\n    # Variables with no equation are exogenous roots.\n    variables = set(equations)\n    for _, parents in equations.values():\n        variables.update(parents)\n\n    variables.update(evidence)\n    variables.update(interventions)\n\n    # Interventions override observations.\n    state = {variable: False for variable in variables}\n    state.update(evidence)\n    state.update(interventions)\n\n    # Iteratively evaluate equations.\n    # Intervened variables are held fixed.\n    for _ in range(max(1, len(variables) * 3)):\n        changed = False\n\n        for variable, (operator, parents) in equations.items():\n            if variable in interventions:\n                continue\n\n            values = [state.get(parent, False) for parent in parents]\n\n            value = (\n                any(values) if operator == \"OR\"\n                else all(values)\n            )\n\n            if state.get(variable) != value:\n                state[variable] = value\n                changed = True\n\n        if not changed:\n            break\n    else:\n        raise RuntimeError(\"Causal equations did not converge.\")\n\n    if target not in state:\n        raise ValueError(f\"Unknown causal target: {target}\")\n\n    return state[target] == expected_value\n\n\n# ------------------------------------------------------------\n# 5. FOL REASONER — REUSE EXISTING FOLIOProver\n# ------------------------------------------------------------\n\ndef folio_private_reason(context_logic, statement_logic):\n    prover = FOLIOProver(\n        timeout_ms=8000,\n        fuzzy_alignment=True\n    )\n\n    prediction, status = prover.prove_folio_detailed(\n        context_logic,\n        statement_logic\n    )\n\n    return bool(prediction), status\n\n\n# ------------------------------------------------------------\n# 6. RUN PRIVATE INFERENCE\n# ------------------------------------------------------------\n\ndef private_predict_one(row):\n    logic_type = row[\"logic_type\"]\n\n    if logic_type == \"tuple_rules\":\n        return tuple_forward_reason(\n            row[\"context_logic\"],\n            row[\"statement_logic\"]\n        ), \"tuple_reasoning\"\n\n    if logic_type == \"causal\":\n        return causal_counterfactual_reason(\n            row[\"context_logic\"],\n            row[\"statement_logic\"]\n        ), \"causal_intervention\"\n\n    if logic_type == \"folio\":\n        return folio_private_reason(\n            row[\"context_logic\"],\n            row[\"statement_logic\"]\n        )\n\n    raise ValueError(f\"Unknown logic type: {logic_type}\")\n\n\nprivate_predictions = []\nprivate_errors = []\n\ninference_start = time.perf_counter()\n\nfor _, row in private_df.iterr