                   ),\n                    parent_operator=operator.upper(),\n                    child=normalize_variable(child),\n                    child_value=not bool(negation)\n                )\n            )\n            continue\n\n        # Single antecedent with multiple effects.\n        match = MULTIPLE_EFFECT_PATTERN.match(statement)\n\n        if match:\n            parent, effect_text = match.groups()\n\n            effects = parse_effect_list(effect_text)\n\n            for child, child_value in effects:\n                mechanisms.append(\n                    CausalMechanism(\n                        parents=(normalize_variable(parent),),\n                        parent_operator=\"AND\",\n                        child=child,\n                        child_value=child_value\n                    )\n                )\n\n    return mechanisms\n\n\n# ------------------------------------------------------------\n# 11.9 Test: single causal mechanism\n# ------------------------------------------------------------\n\ngraph_single = build_causal_graph(\n    \"Ziklo causes Blaf\"\n)\n\nresult_single = simulate_causal_graph(\n    graph_single,\n    interventions={\"ziklo\": True}\n)\n\nassert result_single.outcome(\"ziklo\") is True\nassert result_single.outcome(\"blaf\") is True\nassert result_single.consistent\n\nprint(\"Single-cause propagation test: PASSED\")\n\n\n# ------------------------------------------------------------\n# 11.10 Test: negative causal effect\n# ------------------------------------------------------------\n\ngraph_negative = build_causal_graph(\n    \"Ziklo causes not Blaf\"\n)\n\nresult_negative = simulate_causal_graph(\n    graph_negative,\n    interventions={\"ziklo\": True}\n)\n\nassert result_negative.outcome(\"ziklo\") is True\nassert result_negative.outcome(\"blaf\") is False\nassert result_negative.consistent\n\nprint(\"Negative-effect propagation test: PASSED\")\n\n\n# ------------------------------------------------------------\n# 11.11 Test: conjunctive cause\n# ------------------------------------------------------------\n\ngraph_and = build_causal_graph(\n    \"Blaf and Trune together cause Vork\"\n)\n\nresult_and_incomplete = simulate_causal_graph(\n    graph_and,\n    interventions={\"blaf\": True}\n)\n\nresult_and_complete = simulate_causal_graph(\n    graph_and,\n    interventions={\n        \"blaf\": True,\n        \"trune\": True\n    }\n)\n\nassert result_and_incomplete.outcome(\"vork\") is False\nassert result_and_complete.outcome(\"vork\") is True\n\nprint(\"Conjunctive-cause propagation test: PASSED\")\n\n\n# ------------------------------------------------------------\n# 11.12 Test: disjunctive cause\n# ------------------------------------------------------------\n\ngraph_or = build_causal_graph(\n    \"Trune or Vork causes Lumbo\"\n)\n\nresult_or_false = simulate_causal_graph(\n    graph_or,\n    interventions={}\n)\n\nresult_or_true = simulate_causal_graph(\n    graph_or,\n    interventions={\"trune\": True}\n)\n\nassert result_or_false.outcome(\"lumbo\") is False\nassert result_or_true.outcome(\"lumbo\") is True\n\nprint(\"Disjunctive-cause propagation test: PASSED\")\n\n\n# ------------------------------------------------------------\n# 11.13 Test: multi-step causal chain\n# ------------------------------------------------------------\n\nchain_information = (\n    \"Ziklo causes Blaf. \"\n    \"Blaf causes Trune. \"\n    \"Trune causes Vork. \"\n    \"Vork causes Lumbo.\"\n)\n\ngraph_chain = build_causal_graph(chain_information)\n\nresult_chain = simulate_causal_graph(\n    graph_chain,\n    interventions={\"ziklo\": True}\n)\n\nassert result_chain.outcome(\"blaf\") is True\nassert result_chain.outcome(\"trune\") is True\nassert result_chain.outcome(\"vork\") is True\nassert result_chain.outcome(\"lumbo\") is True\nassert result_chain.consistent\n\nprint(\"Multi-step causal-chain test: PASSED\")\n\n\n# ------------------------------------------------------------\n# 11.14 Test: intervention priority\n# ------------------------------------------------------------\n\ngraph_intervention = build_causal_graph(\n    \"Ziklo causes Blaf. \"\n    \"Blaf causes Trune.\"\n)\n\nresult_intervention = simulate_causal_graph(\n    graph_intervention,\n    interventions={\n        \"ziklo\": True,\n        \"blaf\": False\n    }\n)\n\nassert result_intervention.outcome(\"ziklo\") is True\nassert result_intervention.outcome(\"blaf\") is False\nassert result_intervention.outcome(\"trune\") is False\n\nprint(\"Intervention-priority test: PASSED\")\n\n\n# ------------------------------------------------------------\n# 11.15 Test: contradictory causal effects\n# ------------------------------------------------------------\n\ngraph_conflict = build_causal_graph(\n    \"Ziklo causes Blaf. \"\n    \"Trune causes not Blaf.\"\n)\n\nresult_conflict = simulate_causal_graph(\n    graph_conflict,\n    interventions={\n        \"ziklo\": True,\n        \"trune\": True\n    }\n)\n\nassert not result_conflict.consistent\nassert len(result_conflict.conflicts) > 0\n\nprint(\"Contradictory-effect detection test: PASSED\")\n\n\n# ------------------------------------------------------------\n# 11.16 Test: end-to-end counterfactual prediction\n# ------------------------------------------------------------\n\ntest_question = (\n    \"Would Lumbo occur if not Ziklo instead of Ziklo?\"\n)\n\ntest_prediction = predict_counterfactual(\n    chain_information,\n    test_question\n)\n\nassert test_prediction[\"prediction\"] is False\nassert test_prediction[\"consistent\"]\n\nprint(\"End-to-end counterfactual test: PASSED\")\n\n\n# ------------------------------------------------------------\n# 11.17 Final Section 11 results\n# ------------------------------------------------------------\n\nprint(\"\\n\" + \"=\" * 60)\nprint(\"SECTION 11: CAUSAL REASONING ENGINE\")\nprint(\"=\" * 60)\n\nprint(\"\\nCausal graph summary:\")\nprint(graph_chain.summary())\n\nprint(\"\\nEnd-to-end counterfactual prediction:\")\nprint(\"Outcome:\", test_prediction[\"outcome\"])\nprint(\"Interventions:\", test_prediction[\"interventions\"])\nprint(\"Prediction:\", test_prediction[\"prediction\"])\nprint(\"Final state:\", test_prediction[\"state\"])\nprint(\"Activated mechanisms:\",\n      test_prediction[\"activated_mechanisms\"])\nprint(\"Propagation iterations:\", test_prediction[\"iterations\"])\n\nprint(\"\\nFinal causal chain state:\")\nprint(result_chain.state)\n\nprint(\"\\nSECTION 11 VALIDATION COMPLETED\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T12:40:35.512165Z","iopub.execute_input":"2026-11-17T12:40:35.512891Z","iopub.status.idle":"2026-11-17T12:40:35.56195Z","shell.execute_reply.started":"2026-11-17T12:40:35.512846Z","shell.execute_reply":"2026-11-17T12:40:35.56059Z"}},"outputs":[{"name":"stdout","text":"Single-cause propagation test: PASSED\nNegative-effect propagation test: PASSED\nConjunctive-cause propagation test: PASSED\nDisjunctive-cause propagation test: PASSED\nMulti-step causal-chain test: PASSED\nIntervention-priority test: PASSED\nContradictory-effect detection test: PASSED\nEnd-to-end counterfactual test: PASSED\n\n============================================================\nSECTION 11: CAUSAL REASONING ENGINE\n============================================================\n\nCausal graph summary:\n{'variables': 5, 'mechanisms': 4, 'variables_list': ['blaf', 'lumbo', 'trune', 'vork', 'ziklo']}\n\nEnd-to-end counterfactual prediction:\nOutcome: lumbo\nInterventions: {'ziklo': False}\nPrediction: False\nFinal state: {'lumbo': False, 'ziklo': False, 'blaf': False, 'vork': False, 'trune': False}\nActivated mechanisms: []\nPropagation iterations: 1\n\nFinal causal chain state:\n{'lumbo': True, 'ziklo': True, 'blaf': True, 'vork': True, 'trune': True}\n\nSECTION 11 VALIDATION COMPLETED\n","output_type":"stream"}],"execution_count":10},{"cell_type":"markdown","source":"## Frozen CounterBench Alpha PBCI V1.0","metadata":{}},{"cell_type":"code","source":"# Read-only binding for the frozen Alpha dataset; no Alpha model/evaluator is run here.\nalpha_df = COUNTERBENCH_ALPHA.copy()\nprint(\"CounterBench Alpha dataset loaded for reference:\", len(alpha_df))\nprint(\"Frozen Alpha PBCI V1.0 evaluation is intentionally not rerun.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T12:40:35.563306Z","iopub.execute_input":"2026-11-17T12:40:35.563732Z","iopub.status.idle":"2026-11-17T12:40:35.589686Z","shell.execute_reply.started":"2026-11-17T12:40:35.563707Z","shell.execute_reply":"2026-11-17T12:40:35.588692Z"}},"outputs":[{"name":"stdout","text":"CounterBench Alpha dataset loaded for reference: 1000\nFrozen Alpha PBCI V1.0 evaluation is intentionally not rerun.\n","output_type":"stream"}],"execution_count":11},{"cell_type":"code","source":"\n# ============================================================\n# SECTION — COUNTERBENCH BACKDOOR V2.1\n# Adapted faithfully from the supplied reasoning_agent notebook\n# Includes actual inference-time measurement\n# ============================================================\n\nimport re\nimport math\nimport time\nimport json\nimport itertools\nfrom pathlib import Path\nfrom collections import defaultdict\n\nimport pandas as pd\nfrom sklearn.metrics import (\n    accuracy_score,\n    precision_score,\n    recall_score,\n    f1_score,\n    confusion_matrix\n)\n\n# Ensure paths are Path objects\nOUTPUT_DIR = Path(OUTPUT_DIR)\nOUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n\n\n# --------------------- Parsing utilities ---------------------\n\ndef _cb21_literal(token):\n    \"\"\"Convert a variable phrase to (variable, required_boolean_value).\"\"\"\n    token = str(token).strip().lower().strip(\" .;\")\n\n    negative = re.match(r\"^not\\s+(.+)$\", token)\n\n    if negative:\n        variable = re.sub(r\"^the\\s+\", \"\", negative.group(1)).strip()\n        return variable, False\n\n    variable = re.sub(r\"^the\\s+\", \"\", token).strip()\n    return variable, True\n\n\ndef cb21_parse(given_info):\n    \"\"\"\n    Parse Boolean causal mechanisms and observations.\n\n    A mechanism is stored by effect variable:\n      effect -> [(AND/OR, [(parent, required_value), ...], effect_value)]\n\n    Bernoulli text remains part of the context but is not used as a\n    weighted prior. Root assignments are enumerated uniformly.\n    \"\"\"\n\n    text = str(given_info).strip()\n\n    mechanism_text, *observation_parts = re.split(\n        r\"\\bwe observed\\b\",\n        text,\n        maxsplit=1,\n        flags=re.I\n    )\n\n    mechanism_text = re.sub(\n        r\"^\\s*we know that\\s+\",\n        \"\",\n        mechanism_text,\n        flags=re.I\n    )\n\n    mechanisms = defaultdict(list)\n\n    segments = [\n        part.strip()\n        for part in re.split(\n            r\",\\s*(?:and\\s+)?|\\.\\s*|;\\s*\",\n            mechanism_text\n        )\n        if part.strip()\n    ]\n\n    for segment in segments:\n\n        match = re.match(\n            r\"^(.+?)\\s+(?:together\\s+)?causes?\\s+(not\\s+)?(.+)$\",\n            segment,\n            flags=re.I\n        )\n\n        if not match:\n            continue\n\n        cause_text, negative_effect, effect_text = match.groups()\n\n        effect_text = re.sub(\n            r\"^the\\s+\",\n            \"\",\n            effect_text.strip().lower()\n        ).strip(\" .;\")\n\n        if re.search(r\"\\bor\\b\", cause_text, flags=re.I):\n            operator = \"or\"\n            parent_tokens = re.split(\n                r\"\\s+or\\s+\",\n                cause_text,\n                flags=re.I\n            )\n        else:\n            operator = \"and\"\n            parent_tokens = re.split(\n                r\"\\s+and\\s+\",\n                cause_text,\n                flags=re.I\n            )\n\n        parent_literals = [\n            _cb21_literal(token)\n            for token in parent_tokens\n        ]\n\n        if not effect_text or not parent_literals:\n            continue\n\n        mechanisms[effect_text].append(\n            (\n                operator,\n                parent_literals,\n                not bool(negative_effect)\n            )\n        )\n\n    evidence = []\n\n    if observation_parts:\n\n        observation_text = observation_parts[0].strip().rstrip(\".\")\n\n        for token in re.split(\n            r\"\\s+and\\s+|,\\s*\",\n            observation_text,\n            flags=re.I\n        ):\n            if token.strip():\n                evidence.append(_cb21_literal(token))\n\n    return dict(mechanisms), evidence\n\n\n# --------------------- Causal evaluation ---------------------\n\ndef cb21_evaluate_variable(\n    variable,\n    mechanisms,\n    root_assignment,\n    interventions,\n    memo,\n    stack=()\n):\n    \"\"\"Evaluate one variable recursively under a root assignment and do().\"\"\"\n\n    if variable in interventions:\n        return bool(interventions[variable])\n\n    if variable in memo:\n        return memo[variable]\n\n    if variable not in mechanisms:\n        return bool(root_assignment.get(variable, False))\n\n    if variable in stack:\n        return False\n\n    rule_outputs = []\n\n    for operator, parent_literals, effect_positive in mechanisms[variable]:\n\n        parent_matches = [\n            cb21_evaluate_variable(\n                parent,\n                mechanisms,\n                root_assignment,\n                interventions,\n                memo,\n                stack + (variable,)\n            ) == required_value\n            for parent, required_value in parent_literals\n        ]\n\n        active = (\n            all(parent_matches)\n            if operator == \"and\"\n            else any(parent_matches)\n        )\n\n        rule_outputs.append(\n            bool(active) == bool(effect_positive)\n        )\n\n    value = (\n        any(rule_outputs)\n        if len(rule_outputs) > 1\n        else rule_outputs[0]\n    )\n\n    memo[variable] = bool(value)\n\n    return bool(value)\n\n\n# --------------------- Question patterns ---------------------\n\nCB21_Q1 = re.compile(\n    r\"^\\s*would\\s+(.+?)\\s+(?:still\\s+)?occur\\s+if\\s+(.+?)\"\n    r\"\\s+instead of\\s+(.+?)\\s*\\??\\s*$\",\n    re.I\n)\n\nCB21_Q2 = re.compile(\n    r\"^\\s*if\\s+(.+?)\\s+instead of\\s+(.+?),?\\s+would\\s+(.+?)\"\n    r\"\\s+(?:still\\s+)?occur\\s*\\??\\s*$\",\n    re.I\n)\n\n\n# --------------------- Main reasoning function ---------------------\n\ndef cb21_answer(given_info, question, trace=False):\n    \"\"\"Pearl-style abduction, action, and prediction by root-world enumeration.\"\"\"\n\n    mechanisms, evidence = cb21_parse(given_info)\n\n    match = CB21_Q1.match(str(question).strip())\n\n    if match:\n        target_text, intervention_text, factual_text = match.groups()\n\n    else:\n        match = CB21_Q2.match(str(question).strip())\n\n        if not match:\n            return None\n\n        intervention_text, factual_text, target_text = match.groups()\n\n    target_literals = [\n        _cb21_literal(token)\n        for token in re.split(\n            r\"\\s+and\\s+\",\n            target_text,\n            flags=re.I\n        )\n    ]\n\n    intervention_map = dict(\n        _cb21_literal(token)\n        for token in re.split(\n            r\"\\s+and\\s+\",\n            intervention_text,\n            flags=re.I\n        )\n    )\n\n    factual_literals = [\n        _cb21_literal(token)\n        for token in re.split(\n            r\"\\s+and\\s+\",\n            factual_text,\n            flags=re.I\n        )\n    ]\n\n    evidence_all = evidence + factual_literals\n\n    effect_variables = set(mechanisms)\n\n    parent_variables = {\n        parent\n        for rules in mechanisms.values()\n        for _, literals, _ in rules\n        for parent, _ in literals\n    }\n\n    roots = sorted(\n        (\n            parent_variables\n            | {v for v, _ in evidence_all}\n            | set(intervention_map)\n        ) - effect_variables\n    )\n\n    if len(roots) > 14:\n        raise ValueError(\n            f\"Root enumeration limit exceeded: {len(roots)} roots (max 14).\"\n        )\n\n    compatible_worlds = 0\n    positive_counterfactual_worlds = 0\n    trace_rows = []\n\n    for bits in itertools.product([False, True], repeat=len(roots)):\n\n        assignment = dict(zip(roots, bits))\n\n        factual_memo = {}\n\n        evidence_holds = all(\n            cb21_evaluate_variable(\n                variable,\n                mechanisms,\n                assignment,\n                {},\n                factual_memo\n            ) == required_value\n            for variable, required_value in evidence_all\n        )\n\n        if not evidence_holds:\n            continue\n\n        compatible_worlds += 1\n\n        counterfactual_memo = {}\n\n        target_holds = all(\n            cb21_evaluate_variable(\n                variable,\n                mechanisms,\n                assignment,\n                intervention_map,\n                counterfactual_memo\n            ) == required_value\n            for variable, required_value in target_literals\n        )\n\n        if target_holds:\n            positive_counterfactual_worlds += 1\n\n        if trace:\n            trace_rows.append({\n                \"root_assignment\": assignment,\n                \"target_holds\": target_holds\n            })\n\n    if compatible_worlds == 0:\n        answer = False\n\n    else:\n        # Strict majority; a tie is predicted False.\n        answer = (\n            positive_counterfactual_worlds * 2 > compatible_worlds\n        )\n\n    if trace:\n        return {\n            \"prediction\": bool(answer),\n            \"compatible_worlds\": compatible_worlds,\n            \"positive_worlds\": positive_counterfactual_worlds,\n            \"roots\": roots,\n            \"trace\": trace_rows\n        }\n\n    return bool(answer)\n\n\n# --------------------- Confidence interval ---------------------\n\ndef cb21_wilson_interval(successes, total, z=1.959963984540054):\n\n    if total == 0:\n        return (float(\"nan\"), float(\"nan\"))\n\n    p = successes / total\n\n    denom = 1 + z*z/total\n\n    centre = (\n        p + z*z/(2*total)\n    ) / denom\n\n    margin = (\n        z * math.sqrt(\n            (p*(1-p) + z*z/(4*total))/total\n        ) / denom\n    )\n\n    return (\n        max(0.0, centre-margin),\n        min(1.0, centre+margin)\n    )\n\n\n# --------------------- Focused engine tests ---------------------\n\n_test_context = (\n    \"We know that Blaf causes Ziklo, \"\n    \"Ziklo or Blaf causes Trune, \"\n    \"Trune causes Vork, and Vork causes Lumbo. \"\n    \"Blaf~ Bern(0.2). We observed Trune\"\n)\n\n_test_question = (\n    \"Would Lumbo occur if not Ziklo instead of Ziklo?\"\n)\n\n_test_result = cb21_answer(\n    _test_context,\n    _test_question,\n    trace=True\n)\n\nassert _test_result[\"compatible_worlds\"] > 0\nassert isinstance(_test_result[\"prediction\"], bool)\n\nassert cb21_answer(\n    \"We know that A causes B. We observed A\",\n    \"Would B occur if not A instead of A?\"\n) is False\n\nprint(\"CounterBench Backdoor V2.1 parser/SCM smoke tests passed.\")\nprint(\"Example compatible factual worlds:\", _test_result[\"compatible_worlds\"])\nprint(\"Example positive counterfactual worlds:\", _test_result[\"positive_worlds\"])\n\n\n# ============================================================\n# FULL COUNTERBENCH BACKDOOR V2.1 EVALUATION\n# ============================================================\n\nbackdoor_df = COUNTERBENCH_BACKDOOR.copy()\n\nbackdoor_records = []\nskipped_backdoor = []\n\n# Actual reasoning/inference time only.\ncounterbench_inference_seconds = 0.0\ncounterbench_timed_examples = 0\n\nfor row_index, row in backdoor_df.iterrows():\n\n    try:\n\n        # Measure only the reasoning function execution.\n        inference_start = time.perf_counter()\n\n        prediction = cb21_answer(\n            row[\"given_info\"],\n            row[\"question\"]\n        )\n\n        inference_end = time.perf_counter()\n\n        counterbench_inference_seconds += (\n            inference_end - inference_start\n        )\n\n        counterbench_timed_examples += 1\n\n        answer_text = str(row[\"answer\"]).strip().lower()\n\n        if (\n            prediction is None\n            or answer_text not in {\"yes\", \"no\", \"true\", \"false\"}\n        ):\n\n            skipped_backdoor.append({\n                \"row_index\": int(row_index),\n                \"question_id\": row.get(\"question_id\"),\n                \"reason\": \"unparsed_question_or_label\"\n            })\n\n            continue\n\n        actual = answer_text in {\"yes\", \"true\"}\n\n        backdoor_records.append({\n\n            \"row_index\": int(row_index),\n            \"question_id\": str(row.get(\"question_id\")),\n            \"graph_id\": row.get(\"graph_id\"),\n            \"model_id\": row.get(\"model_id\"),\n            \"question\": row[\"question\"],\n            \"actual\": bool(actual),\n            \"predicted\": bool(prediction),\n            \"correct\": bool(actual == prediction),\n            \"type\": row.get(\"type\", \"backdoor\")\n\n        })\n\n    except Exception as exc:\n\n        skipped_backdoor.append({\n            \"row_index\": int(row_index),\n            \"question_id\": row.get(\"question_id\"),\n            \"reason\": repr(exc)\n        })\n\n\nbackdoor_v21_predictions = pd.DataFrame(backdoor_records)\n\n\n# --------------------- Evaluation validation ---------------------\n\nif len(backdoor_v21_predictions) != len(backdoor_df):\n\n    print(\n        \"WARNING: evaluated\",\n        len(backdoor_v21_predictions),\n        \"of\",\n        len(backdoor_df),\n        \"rows; skipped:\",\n        len(skipped_backdoor)\n    )\n\nelse:\n\n    print(\n        \"All Backdoor V2 rows evaluated:\",\n        len(backdoor_v21_predictions)\n    )\n\n\nif backdoor_v21_predictions.empty:\n    raise RuntimeError(\n        \"CounterBench Backdoor V2.1 produced no predictions.\"\n    )\n\n\ny_true_v21 = (\n    backdoor_v21_predictions[\"actual\"]\n    .astype(bool)\n    .to_numpy()\n)\n\ny_pred_v21 = (\n    backdoor_v21_predictions[\"predicted\"]\n    .astype(bool)\n    .to_numpy()\n)\n\n\n# --------------------- Metrics ---------------------\n\ncm_v21 = confusion_matrix(\n    y_true_v21,\n    y_pred_v21,\n    labels=[False, True]\n)\n\ncorrect_v21 = int(\n    (y_true_v21 == y_pred_v21).sum()\n)\n\nci_v21 = cb21_wilson_interval(\n    correct_v21,\n    len(y_true_v21)\n)\n\naverage_inference_time = (\n    counterbench_inference_seconds / counterbench_timed_examples\n    if counterbench_timed_examples > 0\n    else float(\"nan\")\n)\n\nmetrics_v21 = {\n\n    \"dataset\": \"CounterBench Backdoor V2\",\n\n    \"method\": (\n        \"V2.1 reference SCM root-world abduction \"\n        \"+ intervention + prediction\"\n    ),\n\n    \"examples\": int(len(y_true_v21)),\n\n    \"correct\": correct_v21,\n\n    \"accuracy\": float(\n        accuracy_score(y_true_v21, y_pred_v21)\n    ),\n\n    \"accuracy_wilson_95_ci\": [\n        float(ci_v21[0]),\n        float(ci_v21[1])\n    ],\n\n    \"precision\": float(\n        precision_score(\n            y_true_v21,\n            y_pred_v21,\n            zero_division=0\n        )\n    ),\n\n    \"recall\": float(\n        recall_score(\n            y_true_v21,\n            y_pred_v21,\n            zero_division=0\n        )\n    ),\n\n    \"f1\": float(\n        f1_score(\n            y_true_v21,\n            y_pred_v21,\n            zero_division=0\n        )\n    ),\n\n    \"confusion_matrix_tn_fp_fn_tp\": cm_v21.tolist(),\n\n    \"skipped\": int(len(skipped_backdoor)),\n\n    # NEW: Runtime measurements\n    \"runtime_seconds\": float(counterbench_inference_seconds),\n\n    \"average_inference_seconds_per_example\": float(\n        average_inference_time\n    ),\n\n    \"timed_examples\": int(counterbench_timed_examples)\n\n}\n\n\n# --------------------- Print results ---------------------\n\nprint(\"\\n\" + \"=\" * 78)\nprint(\"COUNTERBENCH BACKDOOR V2.1 — EVALUATION\")\nprint(\"=\" * 78)\n\nprint(\"Examples:\", metrics_v21[\"examples\"])\nprint(\"Correct:\", metrics_v21[\"correct\"])\n\nprint(f\"Accuracy:  {metrics_v21['accuracy']:.4f}\")\nprint(f\"Precision: {metrics_v21['precision']:.4f}\")\nprint(f\"Recall:    {metrics_v21['recall']:.4f}\")\nprint(f\"F1-score:  {metrics_v21['f1']:.4f}\")\n\nprint(\n    \"95% Wilson CI:\",\n    tuple(round(x, 4) for x in ci_v21)\n)\n\nprint(\"\\nConfusion matrix [ [TN, FP], [FN, TP] ]:\")\nprint(cm_v21)\n\nprint(\"\\nINFERENCE TIME\")\nprint(\"-\" * 45)\n\nprint(\n    f\"Total inference time: \"\n    f\"{counterbench_inference_seconds:.6f} seconds\"\n)\n\nprint(\n    f\"Timed examples: {counterbench_timed_examples}\"\n)\n\nprint(\n    f\"Average time per example: \"\n    f\"{average_inference_time:.6f} seconds\"\n)\n\n\n# --------------------- Frozen baseline comparison ---------------------\n\nbaseline_path = OUTPUT_DIR / \"counterbench_backdoor_predictions.csv\"\n\nif baseline_path.exists():\n\n    baseline_df = pd.read_csv(baseline_path)\n\n    required_baseline_cols = {\n        \"question_id\",\n        \"actual\",\n        \"predicted\"\n    }\n\n    if required_baseline_cols.issubset(baseline_df.columns):\n\n        baseline_df[\"question_id\"] = (\n            baseline_df[\"question_id\"].astype(str)\n        )\n\n        comparison = backdoor_v21_predictions.merge(\n\n            baseline_df[\n                [\"question_id\", \"actual\", \"predicted\"]\n            ].rename(\n                columns={\n                    \"actual\": \"baseline_actual\",\n                    \"predicted\": \"baseline_predicted\"\n                }\n            ),\n\n            on=\"question_id\",\n            how=\"inner\",\n            validate=\"one_to_one\"\n        )\n\n        if len(comparison) == len(backdoor_v21_predictions):\n\n            baseline_correct = int(\n                (\n                    comparison[\"actual\"].astype(bool)\n                    == comparison[\"baseline_predicted\"].astype(bool)\n                ).sum()\n            )\n\n            baseline_ci = cb21_wilson_interval(\n                baseline_correct,\n                len(comparison)\n            )\n\n            print(\"\\nFROZEN BASELINE vs V2.1 (matched question IDs)\")\n\n            print(\n                \"Baseline accuracy:\",\n                f\"{baseline_correct/len(comparison):.4f}\"\n            )\n\n            print(\n                \"Baseline 95% Wilson CI:\",\n                tuple(round(x, 4) for x in baseline_ci)\n            )\n\n            print(\n                \"V2.1 accuracy:\",\n                f\"{metrics_v21['accuracy']:.4f}\"\n            )\n\n            print(\n                \"Absolute change (percentage points):\",\n                round(\n                    100 * (\n                        metrics_v21[\"accuracy\"]\n                        - baseline_correct / len(comparison)\n                    ),\n                    2\n                )\n            )\n\n            metrics_v21[\"matched_baseline\"] = {\n\n                \"examples\": int(len(comparison)),\n\n                \"accuracy\": float(\n                    baseline_correct / len(comparison)\n                ),\n\n                \"accuracy_wilson_95_ci\": [\n                    float(baseline_ci[0]),\n                    float(baseline_ci[1])\n                ],\n\n                \"accuracy_change_percentage_points\": float(\n                    100 * (\n                        metrics_v21[\"accuracy\"]\n                        - baseline_correct / len(comparison)\n                    )\n                )\n            }\n\n        else:\n\n            print(\n                \"\\nBaseline comparison skipped: \"\n                \"question IDs did not align 1:1.\"\n            )\n\n    else:\n\n        print(\n            \"\\nBaseline comparison skipped: \"\n            \"expected columns not found.\"\n        )\n\nelse:\n\n    print(\n        \"\\nFrozen baseline file not found; \"\n        \"V2.1 metrics still saved separately.\"\n    )\n\n\n# --------------------- Save outputs ---------------------\n\n# Separate filenames preserve the frozen baseline.\n\nv21_prediction_path = (\n    OUTPUT_DIR / \"counterbench_backdoor_v21_predictions.csv\"\n)\n\nv21_metrics_path = (\n    OUTPUT_DIR / \"counterbench_backdoor_v21_metrics.json\"\n)\n\nv21_errors_path = (\n    OUTPUT_DIR / \"counterbench_backdoor_v21_errors.csv\"\n)\n\n\nbackdoor_v21_predictions.to_csv(\n    v21_prediction_path,\n    index=False\n)\n\nbackdoor_v21_predictions.loc[\n    ~backdoor_v21_predictions[\"correct\"]\n].to_csv(\n    v21_errors_path,\n    index=False\n)\n\n\nwith open(\n    v21_metrics_path,\n    \"w\",\n    encoding=\"utf-8\"\n) as f:\n\n    json.dump(\n        metrics_v21,\n        f,\n        indent=2\n    )\n\n\nif skipped_backdoor:\n\n    pd.DataFrame(skipped_backdoor).to_csv(\n        OUTPUT_DIR / \"counterbench_backdoor_v21_skipped.csv\",\n        index=False\n    )\n\n\nprint(\"\\nV2.1 outputs saved:\")\n\nprint(\" -\", v21_prediction_path)\nprint(\" -\", v21_metrics_path)\nprint(\" -\", v21_errors_path)\n\nprint(\"\\nRuntime successfully recorded in metrics JSON.\")\n\nprint(\n    \"\\nFrozen CounterBench Alpha PBCI V1.0 and \"\n    \"Backdoor V2 baseline files were not modified.\"\n)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-17T12:40:35.591186Z","iopub.execute_input":"2026-11-17T12:40:35.591986Z","iopub.status.idle":"2026-11-17T12:40:35.725344Z","shell.execute_reply.started":"2026-11-17T12:40:35.591944Z","shell.execute_reply":"2026-11-17T12:40:35.724227Z"}},"outputs":[{"name":"stdout","text":"CounterBench Backdoor V2.1 parser/SCM smoke tests passed.\nExample compatible factual worlds: 1\nExample 