f.kb.facts)\n        self.proofs = {\n            fact: {\n                \"type\": \"given_fact\",\n                \"rule_id\": None,\n                \"premises\": ()\n            }\n            for fact in self.kb.facts\n        }\n\n        # Index rules by each antecedent for efficient activation.\n        rules_by_premise = defaultdict(list)\n\n        for rule_index, rule in enumerate(self.kb.rules):\n            for premise in rule.antecedents:\n                rules_by_premise[premise].append(rule_index)\n\n        # Track how many antecedents of each rule remain unproved.\n        remaining = [\n            len(rule.antecedents)\n            for rule in self.kb.rules\n        ]\n\n        # Empty-premise rules can be activated immediately.\n        agenda = deque(self.derived_facts)\n\n        activated_rules = set()\n\n        for rule_index, rule in enumerate(self.kb.rules):\n            if remaining[rule_index] == 0:\n                activated_rules.add(rule_index)\n                agenda.append(rule.consequent)\n\n        # Track which premises have already satisfied each rule.\n        satisfied = [set() for _ in self.kb.rules]\n\n        while agenda:\n            known_literal = agenda.popleft()\n            self.iterations += 1\n\n            for rule_index in rules_by_premise.get(known_literal, []):\n\n                if rule_index in activated_rules:\n                    continue\n\n                if known_literal in satisfied[rule_index]:\n                    continue\n\n                satisfied[rule_index].add(known_literal)\n                remaining[rule_index] -= 1\n\n                if remaining[rule_index] == 0:\n                    activated_rules.add(rule_index)\n\n                    rule = self.kb.rules[rule_index]\n                    conclusion = rule.consequent\n\n                    if conclusion not in self.derived_facts:\n                        self.derived_facts.add(conclusion)\n\n                        self.proofs[conclus